{%- comment -%}
  Petssify Trust Columns ("Trusted Quality", "Exclusive Savings", "Fast & Secure Delivery", "Customer Support")
  - Minimalistic & Premium Pet E-commerce Feature Cards
  - Top: Round Circle Container for Custom Uploaded Image (or handcrafted bespoke SVG pet icons)
  - Middle: Refined Bold Heading (Prevents awkward word splits like "Exclusiv\ne")
  - Bottom: Clear, readable description text
  - Mobile: Native smooth touch swipe carousel ("slides type") with 84vw card peek & animated pill indicator dots
  - Desktop: 4-column balanced grid with smooth hover lift and glowing ring micro-interactions
{%- endcomment -%}

<div
  id="petssify-trust-{{ section.id }}"
  class="petssify-trust-section section-{{ section.id }}-padding"
  style="
    --trust-pt: {{ section.settings.padding_top | default: 60 }}px;
    --trust-pb: {{ section.settings.padding_bottom | default: 60 }}px;
    --circle-size-desktop: {{ section.settings.circle_size_desktop | default: 72 }}px;
    --circle-size-mobile: {{ section.settings.circle_size_mobile | default: 64 }}px;
    --card-bg: {{ section.settings.card_bg | default: '#FFFFFF' }};
    --card-border: {{ section.settings.card_border | default: '#E2E8F0' }};
    --circle-bg: {{ section.settings.circle_bg | default: '#F8FAFC' }};
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="petssify-trust-header">
        <h2 class="petssify-trust-heading">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p class="petssify-trust-subheading">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Feature Cards Track -->
    <div
      class="petssify-trust-track petssify-trust-track--{{ section.settings.mobile_layout | default: 'slides' }}"
      id="PetssifyTrustTrack-{{ section.id }}"
    >
      {%- for block in section.blocks -%}
        <div
          class="petssify-trust-card"
          id="PetssifyTrustSlide-{{ section.id }}-{{ forloop.index0 }}"
          data-slide-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <!-- Top Round Circle Container (Image or Handcrafted SVG Fallback) -->
          <div class="petssify-trust-circle petssify-trust-circle--{{ forloop.index }}">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 280 }}"
                alt="{{ block.settings.title | strip_html | escape }}"
                loading="lazy"
                width="140"
                height="140"
                class="petssify-trust-circle-img"
              >
            {%- else -%}
              <!-- Handcrafted Premium Pet Fallback SVGs -->
              <div class="petssify-trust-circle-icon petssify-trust-circle-icon--{{ forloop.index }}">
                {%- case forloop.index -%}
                  {%- when 1 -%}
                    <!-- Card 1: Trusted Quality (Verified Shield & Star) -->
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      <path d="M9 12l2 2 4-4"/>
                    </svg>
                  {%- when 2 -%}
                    <!-- Card 2: Exclusive Savings (Discount Sparkle & Percentage Tag) -->
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                      <line x1="7" y1="7" x2="7.01" y2="7"/>
                      <path d="M9.5 14.5l5-5M10 10h.01M14 14h.01"/>
                    </svg>
                  {%- when 3 -%}
                    <!-- Card 3: Fast & Secure Delivery (Express Courier Van) -->
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="1" y="3" width="15" height="13" rx="2"/>
                      <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                      <circle cx="5.5" cy="18.5" r="2.5"/>
                      <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                  {%- when 4 -%}
                    <!-- Card 4: Customer Support (24/7 Headset & Caring Heart) -->
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
                      <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
                      <path d="M12 13a2.5 2.5 0 0 0-2.5 2.5c0 1.8 2.5 3.5 2.5 3.5s2.5-1.7 2.5-3.5A2.5 2.5 0 0 0 12 13z"/>
                    </svg>
                  {%- else -%}
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M12 8v8M8 12h8"/>
                    </svg>
                {%- endcase -%}
              </div>
            {%- endif -%}
          </div>

          <!-- Heading (No awkward word breaking) -->
          {%- if block.settings.title != blank -%}
            <h3 class="petssify-trust-title">
              {{ block.settings.title }}
            </h3>
          {%- endif -%}

          <!-- Content Description Text -->
          {%- if block.settings.text != blank -%}
            <div class="petssify-trust-desc rte">
              {{ block.settings.text }}
            </div>
          {%- endif -%}

          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="petssify-trust-link">
              {{ block.settings.link_label }}
              <span aria-hidden="true"> &rarr;</span>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <!-- Mobile Slides Pagination Indicator Dots -->
    {%- if section.blocks.size > 1 -%}
      <div
        class="petssify-trust-dots"
        id="PetssifyTrustDots-{{ section.id }}"
        aria-label="Slide indicators"
      >
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="petssify-trust-dot{% if forloop.first %} active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #petssify-trust-{{ section.id }} {
    padding-top: var(--trust-pt);
    padding-bottom: var(--trust-pb);
    background-color: transparent;
  }

  .petssify-trust-header {
    text-align: center;
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }

  .petssify-trust-heading {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    color: var(--color-primary, #00205B);
    letter-spacing: -0.025em;
    margin: 0 0 8px 0;
  }

  .petssify-trust-subheading {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: clamp(14px, 1.4vw, 15px);
    color: var(--color-text-muted, #64748B);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Desktop Grid Layout: Balanced 4-column cards */
  .petssify-trust-track {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);
    gap: clamp(16px, 2vw, 24px);
    align-items: stretch;
  }

  /* Card Item */
  .petssify-trust-card {
    background: var(--card-bg, #FFFFFF);
    border: 1px solid var(--card-border, #E2E8F0);
    border-radius: 20px;
    padding: clamp(28px, 3vw, 36px) clamp(20px, 2vw, 26px) clamp(24px, 2.5vw, 32px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 4px 16px -2px rgba(0, 32, 91, 0.04);
    transition: transform 0.3s cubic-bezier(0.2, 0, 0.2, 1),
                box-shadow 0.3s cubic-bezier(0.2, 0, 0.2, 1),
                border-color 0.3s ease;
    position: relative;
  }

  @media (hover: hover) {
    .petssify-trust-card:hover {
      transform: translateY(-5px);
      border-color: #CBD5E1;
      box-shadow: 0 16px 32px -4px rgba(0, 32, 91, 0.09),
                  0 0 0 1px rgba(255, 122, 41, 0.18);
    }

    .petssify-trust-card:hover .petssify-trust-circle {
      border-color: var(--color-accent, #FF7A29);
      box-shadow: 0 8px 20px -2px rgba(255, 122, 41, 0.25);
      transform: scale(1.06);
    }

    .petssify-trust-card:hover .petssify-trust-circle-img,
    .petssify-trust-card:hover .petssify-trust-circle-icon svg {
      transform: scale(1.08);
    }
  }

  /* Top Round Circle Avatar Container */
  .petssify-trust-circle {
    width: var(--circle-size-desktop, 72px);
    height: var(--circle-size-desktop, 72px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    margin-bottom: 20px;
    border: 2px solid #E2E8F0;
    background: var(--circle-bg, #F8FAFC);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    box-shadow: 0 4px 12px -2px rgba(0, 32, 91, 0.06);
    transition: transform 0.3s cubic-bezier(0.2, 0, 0.2, 1),
                border-color 0.3s ease,
                box-shadow 0.3s ease;
    flex-shrink: 0;
  }

  .petssify-trust-circle-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    transition: transform 0.35s ease;
  }

  /* Handcrafted SVG Icon Fallback Badges */
  .petssify-trust-circle-icon {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.35s ease;
  }

  .petssify-trust-circle-icon svg {
    transition: transform 0.35s ease;
  }

  /* Badge 1: Quality (Deep Navy & Soft Amber) */
  .petssify-trust-circle-icon--1 {
    background: linear-gradient(135deg, #F0F5FF 0%, #E0EAFF 100%);
    color: #00205B;
  }

  /* Badge 2: Savings (Warm Orange Accent) */
  .petssify-trust-circle-icon--2 {
    background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);
    color: #EA580C;
  }

  /* Badge 3: Fast Delivery (Emerald Teal) */
  .petssify-trust-circle-icon--3 {
    background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);
    color: #16A34A;
  }

  /* Badge 4: Customer Support (Sky Periwinkle) */
  .petssify-trust-circle-icon--4 {
    background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
    color: #2563EB;
  }

  /* Heading Typography (Prevents line break disasters like "Exclusiv\ne") */
  .petssify-trust-title {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(17px, 1.25vw, 19px);
    font-weight: 800;
    color: var(--color-primary, #00205B);
    letter-spacing: -0.015em;
    margin: 0 0 10px 0;
    line-height: 1.3;
    hyphens: none !important;
    word-break: normal !important;
    overflow-wrap: normal !important;
  }

  .petssify-trust-title strong {
    font-weight: 800;
    color: var(--color-primary, #00205B);
  }

  /* Content Text Description */
  .petssify-trust-desc {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: clamp(13.5px, 1vw, 14.5px);
    color: var(--color-text-muted, #64748B);
    line-height: 1.55;
    margin: 0;
    max-width: 290px;
  }

  .petssify-trust-desc p {
    margin: 0;
  }

  .petssify-trust-desc strong {
    color: var(--color-primary, #00205B);
    font-weight: 600;
  }

  /* Optional Link */
  .petssify-trust-link {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-accent, #FF7A29);
    text-decoration: none;
    margin-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .petssify-trust-link:hover {
    gap: 8px;
    color: #D95D10;
  }

  /* Mobile Slide Dots (Hidden on Desktop) */
  .petssify-trust-dots {
    display: none;
  }

  /* =========================================================================
     MOBILE RESPONSIVE MODES (< 768px)
     ========================================================================= */
  @media screen and (max-width: 767px) {
    #petssify-trust-{{ section.id }} {
      padding-top: calc(var(--trust-pt) * 0.7);
      padding-bottom: calc(var(--trust-pb) * 0.7);
    }

    .petssify-trust-header {
      margin-bottom: 20px;
    }

    /* MODE 1: Slides / Swipe Carousel Mode */
    .petssify-trust-track--slides {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 16px;
      padding: 6px 20px 14px;
      margin: 0 -20px;
    }

    .petssify-trust-track--slides::-webkit-scrollbar {
      display: none;
    }

    .petssify-trust-track--slides .petssify-trust-card {
      flex: 0 0 84vw;
      max-width: 325px;
      scroll-snap-align: center;
      padding: 26px 20px 22px;
      border-radius: 18px;
    }

    .petssify-trust-track--slides .petssify-trust-circle {
      width: var(--circle-size-mobile, 64px);
      height: var(--circle-size-mobile, 64px);
      margin-bottom: 14px;
    }

    .petssify-trust-track--slides .petssify-trust-title {
      font-size: 17.5px;
      margin-bottom: 8px;
    }

    .petssify-trust-track--slides .petssify-trust-desc {
      font-size: 13.5px;
      line-height: 1.5;
      max-width: 100%;
    }

    /* Mobile Animated Pill Dots */
    .petssify-trust-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 16px;
    }

    .petssify-trust-dot {
      width: 8px;
      height: 8px;
      border-radius: 9999px;
      background: #CBD5E1;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: width 0.3s cubic-bezier(0.2, 0, 0.2, 1),
                  background-color 0.3s ease;
    }

    .petssify-trust-dot.active {
      width: 24px;
      background: var(--color-primary, #00205B);
    }

    /* MODE 2: 2-Column Grid (Optional) */
    .petssify-trust-track--grid_2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .petssify-trust-track--grid_2 .petssify-trust-card {
      padding: 20px 14px 18px;
    }

    .petssify-trust-track--grid_2 .petssify-trust-circle {
      width: 54px;
      height: 54px;
      margin-bottom: 12px;
    }

    .petssify-trust-track--grid_2 .petssify-trust-title {
      font-size: 15px;
    }

    .petssify-trust-track--grid_2 .petssify-trust-desc {
      font-size: 12.5px;
    }

    /* MODE 3: 1-Column Stack (Optional) */
    .petssify-trust-track--stack {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
  }
</style>

<script>
  (function() {
    function initTrustCarousel() {
      const track = document.getElementById('PetssifyTrustTrack-{{ section.id }}');
      if (!track || !track.classList.contains('petssify-trust-track--slides')) return;

      const dotsContainer = document.getElementById('PetssifyTrustDots-{{ section.id }}');
      if (!dotsContainer) return;
      const dots = dotsContainer.querySelectorAll('.petssify-trust-dot');
      const cards = track.querySelectorAll('.petssify-trust-card');
      if (!dots.length || !cards.length) return;

      // Click dot to scroll to card
      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          const index = parseInt(dot.getAttribute('data-index'), 10);
          if (cards[index]) {
            cards[index].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
          }
        });
      });

      // Update active dot on scroll
      let scrollTimer = null;
      track.addEventListener('scroll', function() {
        if (scrollTimer) cancelAnimationFrame(scrollTimer);
        scrollTimer = requestAnimationFrame(function() {
          const trackCenter = track.scrollLeft + (track.clientWidth / 2);
          let closestIndex = 0;
          let minDistance = Infinity;

          cards.forEach(function(card, idx) {
            const cardCenter = card.offsetLeft + (card.offsetWidth / 2);
            const distance = Math.abs(trackCenter - cardCenter);
            if (distance < minDistance) {
              minDistance = distance;
              closestIndex = idx;
            }
          });

          dots.forEach(function(d, idx) {
            if (idx === closestIndex) {
              d.classList.add('active');
            } else {
              d.classList.remove('active');
            }
          });
        });
      }, { passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTrustCarousel);
    } else {
      initTrustCarousel();
    }
  })();
</script>

{% schema %}
{
  "name": "Trust Feature Cards",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional)"
    },
    {
      "type": "header",
      "content": "Desktop Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Mobile Layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Display",
      "options": [
        {
          "value": "slides",
          "label": "Slides / Swipe Carousel (Recommended)"
        },
        {
          "value": "grid_2",
          "label": "2-Column Grid"
        },
        {
          "value": "stack",
          "label": "1-Column Stack"
        }
      ],
      "default": "slides",
      "info": "Slides layout gives cards room to breathe and prevents broken text lines on mobile."
    },
    {
      "type": "header",
      "content": "Circle & Card Styling"
    },
    {
      "type": "range",
      "id": "circle_size_desktop",
      "label": "Circle Size (Desktop)",
      "min": 56,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "circle_size_mobile",
      "label": "Circle Size (Mobile)",
      "min": 48,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card Border Color",
      "default": "#E2E8F0"
    },
    {
      "type": "color",
      "id": "circle_bg",
      "label": "Circle Background",
      "default": "#F8FAFC"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Feature Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Round Circle Image",
          "info": "Upload your circular image here. If left blank, a handcrafted pet icon is displayed."
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Heading",
          "default": "Trusted Quality"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Content",
          "default": "<p>Premium pet products chosen for comfort, safety & everyday durability.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Button Label (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Petssify Trust Cards",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "Trusted Quality",
            "text": "<p>Premium pet products chosen for comfort, safety & everyday durability.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Exclusive Savings",
            "text": "<p>Get <strong>up to 40% OFF</strong> on selected pet essentials for a limited time.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Fast & Secure Delivery",
            "text": "<p>Safe, quick, and reliable shipping straight to your doorstep.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Customer Support",
            "text": "<p>Friendly support always ready to help you and your pets.</p>"
          }
        }
      ]
    }
  ]
}
