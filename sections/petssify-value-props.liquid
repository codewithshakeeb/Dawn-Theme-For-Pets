{%- comment -%}
  Petssify 4-Column Value Props Section
  Matches Base44 Prototype (Spec 2.3)
{%- endcomment -%}

<div class="petssify-value-props section-{{ section.id }}-padding" style="background-color: var(--color-bg-subtle); padding: 56px 0;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div style="text-align: center; margin-bottom: 40px;">
        <h2 style="font-family: var(--font-heading); font-size: clamp(24px, 3vw, 32px); font-weight: 800; color: var(--color-primary); margin: 0 0 8px 0;">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p style="font-size: 15px; color: var(--color-text-muted); max-width: 600px; margin: 0 auto;">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
      {%- for block in section.blocks -%}
        <div
          class="petssify-value-prop-card"
          {{ block.shopify_attributes }}
          style="background: #FFFFFF; border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 28px 24px; box-shadow: var(--shadow-sm); transition: all var(--transition-normal);"
        >
          <div style="width: 48px; height: 48px; border-radius: var(--radius-btn); background: var(--color-bg-muted); display: flex; align-items: center; justify-content: center; margin-bottom: 20px; color: var(--color-accent);">
            {%- case forloop.index -%}
              {%- when 1 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
              {%- when 2 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              {%- when 3 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              {%- when 4 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
              {%- else -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
            {%- endcase -%}
          </div>

          <h3 style="font-family: var(--font-heading); font-size: 17px; font-weight: 700; color: var(--color-primary); margin: 0 0 10px 0;">
            {{ block.settings.title }}
          </h3>

          <p style="font-family: var(--font-body); font-size: 14px; line-height: 1.6; color: var(--color-text-muted); margin: 0;">
            {{ block.settings.text }}
          </p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .petssify-value-prop-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: #CBD5E1;
  }
</style>

{% schema %}
{
  "name": "Why Shop With Petssify",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Why Shop With Petssify"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "Every product is verified for real pet parents and real routines."
    }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "Value Prop",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Exact Specs Before You Buy"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every listing states verified material grade, dimensions in inches and centimeters, and the weight or coat type it fits—including when a toy isn't made for heavy chewers. No guessing from photos."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Shop With Petssify",
      "blocks": [
        {
          "type": "prop",
          "settings": {
            "title": "Exact Specs Before You Buy",
            "text": "Every listing states verified material grade, dimensions in inches and centimeters, and the weight or coat type it fits—including when a toy isn't made for heavy chewers. No guessing from photos."
          }
        },
        {
          "type": "prop",
          "settings": {
            "title": "30-Day Easy Returns",
            "text": "If a product doesn't fit your pet, return it within 30 days of delivery for a full refund. Items must be unused and in their original packaging."
          }
        },
        {
          "type": "prop",
          "settings": {
            "title": "Ships Across the United States",
            "text": "Orders process in 1–2 business days and arrive in 5–8 business days with live tracking. Free US shipping on all orders over $50."
          }
        },
        {
          "type": "prop",
          "settings": {
            "title": "Reachable Human Support",
            "text": "Email support@petssify.com. We reply within 24 hours, Monday through Friday. Petssify is operated by Dynamic Resolutions LLC."
          }
        }
      ]
    }
  ]
}
{% endschema %}
