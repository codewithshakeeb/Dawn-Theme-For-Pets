{% comment %}
  Petssify 3D Bento Hero — Editorial Sky-Frost DTC Edition
  - Clean, airy Sky-Frost canvas (#EDF4FD) with zero floating sticker collisions
  - Single high-contrast Obsidian Black Eyebrow Pill (#090D16) with pulsing #FF6B00 dot
  - Giant 2-line H1 ("Everything" / "Your Pets Love")
  - 3 peeking pets anchored to top: 0 of the 3-column bottom bento bar
  - Enforced WCAG AAA contrast: Deep Obsidian Navy (#090D16) on Sky-Blue (#ADC8ED)
  - Deep Obsidian-Navy gradient center card with high-impact #FF6B00 CTA
{% endcomment %}

<section
  id="petssify-hero-{{ section.id }}"
  class="ps-hero-section"
  style="
    --ps-upper-bg: {{ section.settings.upper_bg_color | default: '#EDF4FD' }};
    --ps-heading-color: {{ section.settings.heading_color | default: '#090D16' }};
    --ps-side-bg: {{ section.settings.side_cards_bg_color | default: '#ADC8ED' }};
    --ps-side-text: {{ section.settings.side_cards_text_color | default: '#090D16' }};
    --ps-center-bg: {{ section.settings.center_card_bg_color | default: '#0A2540' }};
    --ps-center-text: {{ section.settings.center_card_text_color | default: '#FFFFFF' }};
    --ps-accent: {{ section.settings.accent_orange_color | default: '#FF6B00' }};
    --ps-stage-space: {{ section.settings.upper_stage_space | default: 230 }}px;
    --ps-left-w: {{ section.settings.left_pet_width_pct | default: 72 }};
    --ps-left-ledge: {{ section.settings.left_pet_ledge_pct | default: 66 }};
    --ps-center-w: {{ section.settings.center_pet_width_pct | default: 84 }};
    --ps-center-ledge: {{ section.settings.center_pet_ledge_pct | default: 71 }};
    --ps-right-w: {{ section.settings.right_pet_width_pct | default: 70 }};
    --ps-right-ledge: {{ section.settings.right_pet_ledge_pct | default: 66 }};
    --ps-max-w: {{ section.settings.container_max_width | default: '1680px' }};
  "
>
  <!-- ZONE A: Upper Sky-Frost Stage with Centered Eyebrow & Giant Headline -->
  <div class="ps-hero-upper">
    <div class="ps-hero-container">
      <div class="ps-hero-headline-box">
        {% if section.settings.eyebrow_text != blank %}
          <div class="ps-eyebrow-pill">
            <span class="ps-eyebrow-dot" aria-hidden="true"></span>
            <span>{{ section.settings.eyebrow_text | escape }}</span>
          </div>
        {% endif %}

        <{{ section.settings.heading_tag | default: 'h1' }} class="ps-hero-title">
          {% if section.settings.heading_line_1 != blank %}
            <span class="ps-title-line">{{ section.settings.heading_line_1 | escape }}</span>
          {% endif %}
          {% if section.settings.heading_line_2 != blank %}
            <span class="ps-title-line">{{ section.settings.heading_line_2 | escape }}</span>
          {% endif %}
        </{{ section.settings.heading_tag | default: 'h1' }}>
      </div>
    </div>
  </div>

  <!-- ZONE B: 3-Column Bottom Bento Bar With Pets Locked to top: 0 of Each Card -->
  <div class="ps-bento-bar-outer">
    <div class="ps-bento-grid">

      <!-- CARD 1: LEFT SOCIAL PROOF CARD + LEFT PEEKING PUPPY -->
      <div class="ps-bento-card ps-bento-card--side ps-bento-card--left {% unless section.settings.show_side_pets_on_mobile %}ps-hide-side-pet-mobile{% endunless %}">
        <div class="ps-pet-wrap ps-pet-wrap--left">
          {% if section.settings.left_pet_image != blank %}
            {{
              section.settings.left_pet_image
              | image_url: width: 800
              | image_tag:
                loading: 'eager',
                widths: '260, 380, 520, 800',
                sizes: '(max-width: 767px) 42vw, (max-width: 1200px) 24vw, 340px',
                alt: section.settings.left_pet_alt,
                class: 'ps-pet-img'
            }}
          {% endif %}
        </div>

        <div class="ps-card-content">
          <div class="ps-stat-inline">
            {% if section.settings.left_stat_number != blank %}
              <span class="ps-stat-big">{{ section.settings.left_stat_number | escape }}</span>
            {% endif %}
            <div class="ps-avatars">
              {% if section.settings.left_avatar_1 != blank %}
                {{
                  section.settings.left_avatar_1
                  | image_url: width: 100
                  | image_tag:
                    loading: 'lazy',
                    width: 38,
                    height: 38,
                    alt: 'Happy customer',
                    class: 'ps-avatar-circle'
                }}
              {% endif %}
              {% if section.settings.left_avatar_2 != blank %}
                {{
                  section.settings.left_avatar_2
                  | image_url: width: 100
                  | image_tag:
                    loading: 'lazy',
                    width: 38,
                    height: 38,
                    alt: 'Happy pet',
                    class: 'ps-avatar-circle'
                }}
              {% endif %}
              {% if section.settings.left_badge_text != blank %}
                <span class="ps-plus-circle">{{ section.settings.left_badge_text | escape }}</span>
              {% endif %}
            </div>
          </div>
          {% if section.settings.left_card_subtext != blank %}
            <p class="ps-card-caption">{{ section.settings.left_card_subtext | newline_to_br }}</p>
          {% endif %}
        </div>
      </div>

      <!-- CARD 2: CENTER OBSIDIAN-NAVY CTA CARD + CENTER HERO GOLDEN RETRIEVER -->
      <div class="ps-bento-card ps-bento-card--center">
        <div class="ps-pet-wrap ps-pet-wrap--center">
          {% if section.settings.center_pet_image != blank %}
            {{
              section.settings.center_pet_image
              | image_url: width: 1100
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '340, 480, 680, 900, 1100',
                sizes: '(max-width: 767px) 70vw, (max-width: 1200px) 32vw, 460px',
                alt: section.settings.center_pet_alt,
                class: 'ps-pet-img'
            }}
          {% endif %}
        </div>

        <div class="ps-card-content">
          {% if section.settings.center_card_heading != blank %}
            <h2 class="ps-cta-heading">{{ section.settings.center_card_heading | newline_to_br }}</h2>
          {% endif %}
          {% if section.settings.cta_button_label != blank %}
            <a href="{{ section.settings.cta_button_link | default: '/collections/all' }}" class="ps-cta-btn">
              <span>{{ section.settings.cta_button_label | escape }}</span>
              <span class="ps-cta-arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4.16669 10H15.8334M15.8334 10L10.8334 5M15.8334 10L10.8334 15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- CARD 3: RIGHT RATING CARD + RIGHT PEEKING CAT -->
      <div class="ps-bento-card ps-bento-card--side ps-bento-card--right {% unless section.settings.show_side_pets_on_mobile %}ps-hide-side-pet-mobile{% endunless %}">
        <div class="ps-pet-wrap ps-pet-wrap--right">
          {% if section.settings.right_pet_image != blank %}
            {{
              section.settings.right_pet_image
              | image_url: width: 800
              | image_tag:
                loading: 'eager',
                widths: '260, 380, 520, 800',
                sizes: '(max-width: 767px) 42vw, (max-width: 1200px) 24vw, 340px',
                alt: section.settings.right_pet_alt,
                class: 'ps-pet-img'
            }}
          {% endif %}
        </div>

        <div class="ps-card-content">
          <div class="ps-stat-inline">
            {% if section.settings.right_rating_value != blank %}
              <span class="ps-stat-big">{{ section.settings.right_rating_value | escape }}</span>
            {% endif %}
            {% if section.settings.show_star_icon %}
              <span class="ps-star-svg" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2.25L14.91 8.15L21.42 9.1L16.71 13.69L17.82 20.17L12 17.11L6.18 20.17L7.29 13.69L2.58 9.1L9.09 8.15L12 2.25Z"/>
                </svg>
              </span>
            {% endif %}
          </div>
          {% if section.settings.right_card_subtext != blank %}
            <p class="ps-card-caption">{{ section.settings.right_card_subtext | newline_to_br }}</p>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #petssify-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: 100vw;
    background-color: var(--ps-upper-bg);
    overflow: hidden;
    box-sizing: border-box;
  }

  #petssify-hero-{{ section.id }} *,
  #petssify-hero-{{ section.id }} *::before,
  #petssify-hero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* ZONE A: Upper Stage — Airy, Editorial Canvas */
  #petssify-hero-{{ section.id }} .ps-hero-upper {
    position: relative;
    z-index: 1;
    padding-top: clamp(28px, 3.5vw, 52px);
    padding-bottom: clamp(150px, 18.5vw, 245px);
  }

  #petssify-hero-{{ section.id }} .ps-hero-container {
    position: relative;
    max-width: var(--ps-max-w);
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 40px);
  }

  /* Center Headline Stack */
  #petssify-hero-{{ section.id }} .ps-hero-headline-box {
    text-align: center;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* High-Contrast Obsidian Black Eyebrow Pill with Pulsing Orange Dot */
  #petssify-hero-{{ section.id }} .ps-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #090D16;
    color: #FFFFFF;
    border: 1.5px solid rgba(255, 107, 0, 0.6);
    border-radius: 999px;
    padding: 7px 18px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 16px;
    box-shadow: 0 6px 18px rgba(9, 13, 22, 0.12);
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--ps-accent);
    box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.28);
    display: inline-block;
    flex-shrink: 0;
    animation: psEyebrowPulse 2s infinite;
  }

  @keyframes psEyebrowPulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.28); }
    50% { box-shadow: 0 0 0 6px rgba(255, 107, 0, 0); }
  }

  /* Giant 2-Line Hero Display Headline */
  #petssify-hero-{{ section.id }} .ps-hero-title {
    margin: 0;
    color: var(--ps-heading-color);
    font-size: clamp(2.75rem, 7.2vw, 6.75rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.03em;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-title-line {
    display: block;
  }

  /* ZONE B: 3-Column Bottom Bento Bar */
  #petssify-hero-{{ section.id }} .ps-bento-bar-outer {
    position: relative;
    z-index: 2;
    width: 100%;
    background: linear-gradient(
      90deg,
      var(--ps-side-bg) 0%,
      var(--ps-side-bg) 33%,
      var(--ps-center-bg) 33%,
      var(--ps-center-bg) 67%,
      var(--ps-side-bg) 67%,
      var(--ps-side-bg) 100%
    );
  }

  #petssify-hero-{{ section.id }} .ps-bento-grid {
    max-width: var(--ps-max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.14fr) minmax(0, 1fr);
    align-items: stretch;
    gap: 0;
  }

  #petssify-hero-{{ section.id }} .ps-bento-card {
    position: relative;
    overflow: visible;
    min-height: 215px;
    padding: 48px 20px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  /* High Contrast: Deep Obsidian Navy text on Sky-Blue Cards (#ADC8ED) */
  #petssify-hero-{{ section.id }} .ps-bento-card--side {
    background-color: var(--ps-side-bg);
    color: #090D16 !important;
  }

  /* Center Card: Deep Obsidian-Navy Gradient + Proper Breathing Room */
  #petssify-hero-{{ section.id }} .ps-bento-card--center {
    background: linear-gradient(180deg, #090D16 0%, #0A2540 100%) !important;
    color: var(--ps-center-text);
    border-top: 3.5px solid var(--ps-accent);
    min-height: 215px !important;
    padding: 48px 24px 36px !important;
    z-index: 3;
  }

  /* CARD-TOP LEDGE ANCHOR: 66% on Left/Right, 71% Center */
  #petssify-hero-{{ section.id }} .ps-pet-wrap {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 5;
    pointer-events: none;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  #petssify-hero-{{ section.id }} .ps-pet-wrap--left {
    width: calc(var(--ps-left-w) * 1%);
    max-width: 340px;
    transform: translate(-50%, calc(-1% * var(--ps-left-ledge)));
  }

  #petssify-hero-{{ section.id }} .ps-pet-wrap--center {
    width: calc(var(--ps-center-w) * 1%);
    max-width: 460px;
    transform: translate(-50%, calc(-1% * var(--ps-center-ledge)));
  }

  #petssify-hero-{{ section.id }} .ps-pet-wrap--right {
    width: calc(var(--ps-right-w) * 1%);
    max-width: 340px;
    transform: translate(-50%, calc(-1% * var(--ps-right-ledge)));
  }

  #petssify-hero-{{ section.id }} .ps-pet-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Card Content */
  #petssify-hero-{{ section.id }} .ps-card-content {
    position: relative;
    z-index: 6;
    max-width: 300px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  #petssify-hero-{{ section.id }} .ps-stat-inline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  #petssify-hero-{{ section.id }} .ps-stat-big {
    font-size: clamp(30px, 3vw, 46px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #090D16 !important;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-avatars {
    display: inline-flex;
    align-items: center;
  }

  #petssify-hero-{{ section.id }} .ps-avatar-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #ffffff;
    margin-left: -10px;
  }

  #petssify-hero-{{ section.id }} .ps-avatar-circle:first-child {
    margin-left: 0;
  }

  #petssify-hero-{{ section.id }} .ps-plus-circle {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: #090D16;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 700;
    margin-left: -10px;
    border: 2px solid var(--ps-side-bg);
  }

  #petssify-hero-{{ section.id }} .ps-star-svg {
    width: 32px;
    height: 32px;
    color: var(--ps-accent);
    display: inline-flex;
  }

  #petssify-hero-{{ section.id }} .ps-card-caption {
    margin: 0;
    font-size: clamp(13px, 1.05vw, 15px);
    font-weight: 600;
    line-height: 1.4;
    color: #090D16 !important;
    opacity: 0.92;
    font-family: var(--font-body, 'Inter', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-cta-heading {
    margin: 0 0 10px;
    font-size: clamp(19px, 1.65vw, 25px);
    font-weight: 800;
    line-height: 1.22;
    color: #FFFFFF !important;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background-color: var(--ps-accent);
    color: #ffffff !important;
    text-decoration: none;
    padding: 7px 7px 7px 26px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 800;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 16px rgba(255, 107, 0, 0.38);
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(255, 107, 0, 0.45);
  }

  #petssify-hero-{{ section.id }} .ps-cta-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #ffffff;
    color: var(--ps-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #petssify-hero-{{ section.id }} .ps-cta-arrow svg {
    width: 18px;
    height: 18px;
  }

  @media screen and (max-width: 767px) {
    #petssify-hero-{{ section.id }} .ps-hero-upper {
      padding-top: 24px;
      padding-bottom: clamp(160px, 46vw, 220px);
    }

    #petssify-hero-{{ section.id }} .ps-bento-bar-outer {
      background: none;
    }

    #petssify-hero-{{ section.id }} .ps-bento-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    #petssify-hero-{{ section.id }} .ps-bento-card--center {
      grid-column: 1 / -1;
      order: 1;
      min-height: 195px !important;
      padding: 46px 20px 28px !important;
    }

    #petssify-hero-{{ section.id }} .ps-pet-wrap--center {
      width: min(72vw, 290px);
    }

    #petssify-hero-{{ section.id }} .ps-bento-card--left {
      grid-column: 1 / 2;
      order: 2;
      min-height: 135px;
      padding: 20px 10px;
      border-right: 1px solid rgba(9, 13, 22, 0.1);
    }

    #petssify-hero-{{ section.id }} .ps-bento-card--right {
      grid-column: 2 / 3;
      order: 3;
      min-height: 135px;
      padding: 20px 10px;
    }

    #petssify-hero-{{ section.id }} .ps-hide-side-pet-mobile .ps-pet-wrap {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Petssify 3D Bento Hero",
  "tag": "section",
  "class": "section-petssify-hero-bento",
  "settings": [
    {
      "type": "header",
      "content": "1. Headline & Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Top Eyebrow Pill Text",
      "default": "BLACK FRIDAY EVENT • UP TO 70% OFF SITEWIDE"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Headline Line 1",
      "default": "Everything"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Headline Line 2",
      "default": "Your Pets Love"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading SEO Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "2. Pet Cutouts (Width & Ledge %)"
    },
    {
      "type": "image_picker",
      "id": "center_pet_image",
      "label": "Center Hero Dog PNG"
    },
    {
      "type": "text",
      "id": "center_pet_alt",
      "label": "Center Dog Alt Text",
      "default": "Golden retriever peeking over Petssify Black Friday banner"
    },
    {
      "type": "range",
      "id": "center_pet_width_pct",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Center Dog Width (%)",
      "default": 84
    },
    {
      "type": "range",
      "id": "center_pet_ledge_pct",
      "min": 45,
      "max": 90,
      "step": 1,
      "unit": "%",
      "label": "Center Dog Vertical Ledge %",
      "default": 71
    },
    {
      "type": "image_picker",
      "id": "left_pet_image",
      "label": "Left Puppy PNG"
    },
    {
      "type": "text",
      "id": "left_pet_alt",
      "label": "Left Puppy Alt Text",
      "default": "Dachshund puppy peeking over left card"
    },
    {
      "type": "range",
      "id": "left_pet_width_pct",
      "min": 40,
      "max": 95,
      "step": 1,
      "unit": "%",
      "label": "Left Puppy Width (%)",
      "default": 72
    },
    {
      "type": "range",
      "id": "left_pet_ledge_pct",
      "min": 45,
      "max": 90,
      "step": 1,
      "unit": "%",
      "label": "Left Puppy Vertical Ledge %",
      "default": 66
    },
    {
      "type": "image_picker",
      "id": "right_pet_image",
      "label": "Right Cat PNG"
    },
    {
      "type": "text",
      "id": "right_pet_alt",
      "label": "Right Cat Alt Text",
      "default": "Tabby cat peeking over right card"
    },
    {
      "type": "range",
      "id": "right_pet_width_pct",
      "min": 40,
      "max": 95,
      "step": 1,
      "unit": "%",
      "label": "Right Cat Width (%)",
      "default": 70
    },
    {
      "type": "range",
      "id": "right_pet_ledge_pct",
      "min": 45,
      "max": 90,
      "step": 1,
      "unit": "%",
      "label": "Right Cat Vertical Ledge %",
      "default": 66
    },
    {
      "type": "checkbox",
      "id": "show_side_pets_on_mobile",
      "label": "Show Side Pets on Mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "3. Bento Cards Content"
    },
    {
      "type": "text",
      "id": "left_stat_number",
      "label": "Left Stat Number",
      "default": "98K+"
    },
    {
      "type": "image_picker",
      "id": "left_avatar_1",
      "label": "Customer Avatar 1"
    },
