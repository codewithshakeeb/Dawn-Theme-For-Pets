{% comment %}
  Petssify 3D Bento Hero — Luxury Black Friday Edition (Fixed Layout)
  - Fixes left/right floating widget collision (Hanging Tag on Left, Frosted Countdown Card on Right)
  - Fixes headline-to-dog gap and white strip under Left Puppy paws
  - Fixes washed-out side card contrast (#090D16 text on #ADC8ED sky-blue cards)
  - Centers CTA button with generous padding
{% endcomment %}

<section
  id="petssify-hero-{{ section.id }}"
  class="ps-hero-section"
  style="
    --ps-upper-bg: {{ section.settings.upper_bg_color | default: '#EDF4FD' }};
    --ps-heading-color: {{ section.settings.heading_color | default: '#090D16' }};
    --ps-side-bg: {{ section.settings.side_cards_bg_color | default: '#ADC8ED' }};
    --ps-side-text: {{ section.settings.side_cards_text_color | default: '#090D16' }};
    --ps-center-bg: {{ section.settings.center_card_bg_color | default: '#0A2540' }};
    --ps-center-text: {{ section.settings.center_card_text_color | default: '#FFFFFF' }};
    --ps-accent: {{ section.settings.accent_orange_color | default: '#FF6B00' }};
    --ps-h1-desktop: {{ section.settings.heading_size_desktop | default: 112 }}px;
    --ps-h1-mobile: {{ section.settings.heading_size_mobile | default: 42 }}px;
    --ps-stage-space: {{ section.settings.upper_stage_space | default: 230 }}px;
    --ps-left-w: {{ section.settings.left_pet_width_pct | default: 72 }};
    --ps-left-ledge: {{ section.settings.left_pet_ledge_pct | default: 66 }};
    --ps-center-w: {{ section.settings.center_pet_width_pct | default: 84 }};
    --ps-center-ledge: {{ section.settings.center_pet_ledge_pct | default: 71 }};
    --ps-right-w: {{ section.settings.right_pet_width_pct | default: 70 }};
    --ps-right-ledge: {{ section.settings.right_pet_ledge_pct | default: 66 }};
    --ps-max-w: {{ section.settings.container_max_width | default: '1680px' }};
  "
>
  <!-- ZONE A: Upper Sky-Frost Stage, Floating Left/Right Widgets & Giant Headline -->
  <div class="ps-hero-upper">
    <div class="ps-hero-container">

      {% if section.settings.enable_bf_widgets %}
        <!-- LEFT FLOATING WIDGET: 3D Hanging Black Price Tag (Strictly Left) -->
        <div class="ps-bf-left-tag" aria-hidden="true">
          <div class="ps-tag-cord"></div>
          <div class="ps-tag-body">
            <span class="ps-tag-hole"></span>
            <span class="ps-tag-eyebrow">{{ section.settings.left_tag_eyebrow | default: 'BLACK FRIDAY' }}</span>
            <span class="ps-tag-upto">{{ section.settings.left_tag_top | default: 'UP TO' }}</span>
            <span class="ps-tag-big">{{ section.settings.left_tag_stat | default: '70%' }}</span>
            <span class="ps-tag-off">{{ section.settings.left_tag_bottom | default: 'OFF' }}</span>
            <span class="ps-tag-pill">{{ section.settings.left_tag_pill | default: 'ENTIRE WEBSITE' }}</span>
          </div>
        </div>

        <!-- RIGHT FLOATING WIDGET: Frosted Glass & Obsidian Live Countdown Card (Strictly Right) -->
        <div class="ps-bf-right-card" data-hero-bf-timer>
          <span class="ps-rc-pill">{{ section.settings.right_card_pill | default: '⚡ EXTRA 20% OFF SALE' }}</span>
          <p class="ps-rc-title">{{ section.settings.right_card_title | default: 'Auto-Applied at Checkout' }}</p>
          <div class="ps-rc-timer" data-hero-clock>
            <div class="ps-rc-unit"><span data-d>01</span><small>D</small></div>
            <span class="ps-rc-sep">:</span>
            <div class="ps-rc-unit"><span data-h>18</span><small>H</small></div>
            <span class="ps-rc-sep">:</span>
            <div class="ps-rc-unit"><span data-m>45</span><small>M</small></div>
            <span class="ps-rc-sep">:</span>
            <div class="ps-rc-unit"><span data-s>12</span><small>S</small></div>
          </div>
          <span class="ps-rc-sub">{{ section.settings.right_card_sub | default: 'Valid on All Dog & Cat Gear' }}</span>
        </div>
      {% endif %}

      <!-- CENTER HEADLINE STACK -->
      <div class="ps-hero-headline-box">
        {% if section.settings.eyebrow_text != blank %}
          <div class="ps-eyebrow-pill">
            <span class="ps-eyebrow-dot" aria-hidden="true"></span>
            <span>{{ section.settings.eyebrow_text | escape }}</span>
          </div>
        {% endif %}

        <{{ section.settings.heading_tag | default: 'h1' }} class="ps-hero-title">
          {% if section.settings.heading_line_1 != blank %}
            <span class="ps-title-line">{{ section.settings.heading_line_1 | escape }}</span>
          {% endif %}
          {% if section.settings.heading_line_2 != blank %}
            <span class="ps-title-line">{{ section.settings.heading_line_2 | escape }}</span>
          {% endif %}
        </{{ section.settings.heading_tag | default: 'h1' }}>

        {% if section.settings.enable_bf_widgets %}
          <!-- Compact Mobile Promo Pills (Visible Only Below 1024px) -->
          <div class="ps-mobile-bf-pills" aria-label="Black Friday Mobile Deals">
            <span class="ps-mob-pill ps-mob-pill--dark">🏷️ Up to 70% OFF Sitewide</span>
            <span class="ps-mob-pill ps-mob-pill--orange">⚡ Extra 20% OFF at Checkout</span>
          </div>
        {% endif %}
      </div>

    </div>
  </div>

  <!-- ZONE B: 3-Column Bottom Bento Bar With Pets Locked to `top: 0` of Each Card -->
  <div class="ps-bento-bar-outer">
    <div class="ps-bento-grid">

      <!-- CARD 1: LEFT SOCIAL PROOF CARD + LEFT PEEKING PUPPY -->
      <div class="ps-bento-card ps-bento-card--side ps-bento-card--left {% unless section.settings.show_side_pets_on_mobile %}ps-hide-side-pet-mobile{% endunless %}">
        <div class="ps-pet-wrap ps-pet-wrap--left">
          {% if section.settings.left_pet_image != blank %}
            {{
              section.settings.left_pet_image
              | image_url: width: 800
              | image_tag:
                loading: 'eager',
                widths: '260, 380, 520, 800',
                sizes: '(max-width: 767px) 42vw, (max-width: 1200px) 24vw, 340px',
                alt: section.settings.left_pet_alt,
                class: 'ps-pet-img'
            }}
          {% endif %}
        </div>

        <div class="ps-card-content">
          <div class="ps-stat-inline">
            {% if section.settings.left_stat_number != blank %}
              <span class="ps-stat-big">{{ section.settings.left_stat_number | escape }}</span>
            {% endif %}
            <div class="ps-avatars">
              {% if section.settings.left_avatar_1 != blank %}
                {{
                  section.settings.left_avatar_1
                  | image_url: width: 100
                  | image_tag:
                    loading: 'lazy',
                    width: 38,
                    height: 38,
                    alt: 'Happy customer',
                    class: 'ps-avatar-circle'
                }}
              {% endif %}
              {% if section.settings.left_avatar_2 != blank %}
                {{
                  section.settings.left_avatar_2
                  | image_url: width: 100
                  | image_tag:
                    loading: 'lazy',
                    width: 38,
                    height: 38,
                    alt: 'Happy pet',
                    class: 'ps-avatar-circle'
                }}
              {% endif %}
              {% if section.settings.left_badge_text != blank %}
                <span class="ps-plus-circle">{{ section.settings.left_badge_text | escape }}</span>
              {% endif %}
            </div>
          </div>
          {% if section.settings.left_card_subtext != blank %}
            <p class="ps-card-caption">{{ section.settings.left_card_subtext | newline_to_br }}</p>
          {% endif %}
        </div>
      </div>

      <!-- CARD 2: CENTER OBSIDIAN-NAVY CTA CARD + CENTER HERO GOLDEN RETRIEVER -->
      <div class="ps-bento-card ps-bento-card--center">
        <div class="ps-pet-wrap ps-pet-wrap--center">
          {% if section.settings.center_pet_image != blank %}
            {{
              section.settings.center_pet_image
              | image_url: width: 1100
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '340, 480, 680, 900, 1100',
                sizes: '(max-width: 767px) 70vw, (max-width: 1200px) 32vw, 460px',
                alt: section.settings.center_pet_alt,
                class: 'ps-pet-img'
            }}
          {% endif %}
        </div>

        <div class="ps-card-content">
          {% if section.settings.center_card_heading != blank %}
            <h2 class="ps-cta-heading">{{ section.settings.center_card_heading | newline_to_br }}</h2>
          {% endif %}
          {% if section.settings.cta_button_label != blank %}
            <a href="{{ section.settings.cta_button_link | default: '/collections/all' }}" class="ps-cta-btn">
              <span>{{ section.settings.cta_button_label | escape }}</span>
              <span class="ps-cta-arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4.16669 10H15.8334M15.8334 10L10.8334 5M15.8334 10L10.8334 15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- CARD 3: RIGHT RATING CARD + RIGHT PEEKING CAT -->
      <div class="ps-bento-card ps-bento-card--side ps-bento-card--right {% unless section.settings.show_side_pets_on_mobile %}ps-hide-side-pet-mobile{% endunless %}">
        <div class="ps-pet-wrap ps-pet-wrap--right">
          {% if section.settings.right_pet_image != blank %}
            {{
              section.settings.right_pet_image
              | image_url: width: 800
              | image_tag:
                loading: 'eager',
                widths: '260, 380, 520, 800',
                sizes: '(max-width: 767px) 42vw, (max-width: 1200px) 24vw, 340px',
                alt: section.settings.right_pet_alt,
                class: 'ps-pet-img'
            }}
          {% endif %}
        </div>

        <div class="ps-card-content">
          <div class="ps-stat-inline">
            {% if section.settings.right_rating_value != blank %}
              <span class="ps-stat-big">{{ section.settings.right_rating_value | escape }}</span>
            {% endif %}
            {% if section.settings.show_star_icon %}
              <span class="ps-star-svg" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2.25L14.91 8.15L21.42 9.1L16.71 13.69L17.82 20.17L12 17.11L6.18 20.17L7.29 13.69L2.58 9.1L9.09 8.15L12 2.25Z"/>
                </svg>
              </span>
            {% endif %}
          </div>
          {% if section.settings.right_card_subtext != blank %}
            <p class="ps-card-caption">{{ section.settings.right_card_subtext | newline_to_br }}</p>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #petssify-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: 100vw;
    background-color: var(--ps-upper-bg);
    overflow: hidden;
    box-sizing: border-box;
  }

  #petssify-hero-{{ section.id }} *,
  #petssify-hero-{{ section.id }} *::before,
  #petssify-hero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* ZONE A: Upper Stage — Reduced bottom padding to lock headline and Golden Retriever */
  #petssify-hero-{{ section.id }} .ps-hero-upper {
    position: relative;
    z-index: 1;
    padding-top: clamp(18px, 2.2vw, 34px);
    padding-bottom: clamp(150px, 18.5vw, 245px);
  }

  #petssify-hero-{{ section.id }} .ps-hero-container {
    position: relative;
    max-width: var(--ps-max-w);
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 40px);
  }

  /* LEFT FLOATING HANGING TAG (Strictly Left — Zero Collision) */
  #petssify-hero-{{ section.id }} .ps-bf-left-tag {
    position: absolute;
    left: clamp(28px, 5.5vw, 90px) !important;
    right: auto !important;
    top: 0 !important;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: rotate(-6deg);
    transform-origin: top center;
    animation: psTagSwing 4.5s ease-in-out infinite;
    pointer-events: none;
  }

  #petssify-hero-{{ section.id }} .ps-tag-cord {
    width: 2px;
    height: 56px;
    background-color: #090D16;
    margin: 0 auto;
  }

  #petssify-hero-{{ section.id }} .ps-tag-body {
    background: linear-gradient(145deg, #141C2E 0%, #090D16 100%);
    color: #FFFFFF;
    border: 2px solid var(--ps-accent);
    border-radius: 14px;
    padding: 14px 20px 14px;
    box-shadow: 0 16px 32px rgba(9, 13, 22, 0.22);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 140px;
    box-sizing: border-box;
  }

  #petssify-hero-{{ section.id }} .ps-tag-hole {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--ps-upper-bg);
    border: 2px solid var(--ps-accent);
    margin-bottom: 8px;
  }

  #petssify-hero-{{ section.id }} .ps-tag-eyebrow {
    font-size: 10px;
    font-weight: 800;
    color: var(--ps-accent);
    letter-spacing: 0.08em;
    margin-bottom: 2px;
    text-transform: uppercase;
    font-family: var(--font-heading, sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-tag-upto {
    font-size: 13px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 0.04em;
    font-family: var(--font-heading, sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-tag-big {
    font-size: 44px;
    font-weight: 900;
    line-height: 0.92;
    color: #FFFFFF;
    letter-spacing: -0.03em;
    margin: 2px 0;
    font-family: var(--font-heading, sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-tag-off {
    font-size: 20px;
    font-weight: 800;
    line-height: 1;
    color: #FFFFFF;
    margin-bottom: 8px;
    font-family: var(--font-heading, sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-tag-pill {
    background-color: var(--ps-accent);
    color: #FFFFFF;
    font-size: 9.5px;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 999px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-family: var(--font-heading, sans-serif);
    display: inline-block;
  }

  /* RIGHT FLOATING FROSTED GLASS & BLACK COUNTDOWN CARD (Strictly Right — Zero Collision) */
  #petssify-hero-{{ section.id }} .ps-bf-right-card {
    position: absolute;
    right: clamp(28px, 5.5vw, 90px) !important;
    left: auto !important;
    top: 88px !important;
    z-index: 3;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1.5px solid rgba(9, 13, 22, 0.12);
    border-radius: 18px;
    padding: 16px 20px;
    box-shadow: 0 20px 40px rgba(9, 37, 64, 0.12);
    width: 220px;
    text-align: center;
    transform: rotate(4deg);
    animation: psCardFloat 5s ease-in-out infinite;
    pointer-events: none;
    box-sizing: border-box;
  }

  #petssify-hero-{{ section.id }} .ps-rc-pill {
    display: inline-block;
    background-color: #090D16;
    color: #FF6B00;
    font-size: 10.5px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 999px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-family: var(--font-heading, sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-rc-title {
    margin: 8px 0 6px;
    font-size: 15px;
    font-weight: 800;
    color: #090D16;
    line-height: 1.2;
    font-family: var(--font-heading, sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-rc-timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin-bottom: 6px;
  }

  #petssify-hero-{{ section.id }} .ps-rc-unit {
    background-color: #090D16;
    color: #FFFFFF;
    border-radius: 6px;
    padding: 4px 6px;
    min-width: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  #petssify-hero-{{ section.id }} .ps-rc-unit span {
    font-size: 13px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  #petssify-hero-{{ section.id }} .ps-rc-unit small {
    font-size: 8px;
    color: #FF6B00;
    font-weight: 700;
    margin-top: 2px;
  }

  #petssify-hero-{{ section.id }} .ps-rc-sep {
    font-weight: 800;
    color: #090D16;
    font-size: 12px;
  }

  #petssify-hero-{{ section.id }} .ps-rc-sub {
    display: block;
    font-size: 10.5px;
    font-weight: 600;
    color: #475569;
  }

  @keyframes psTagSwing {
    0%, 100% { transform: rotate(-6deg) translateY(0); }
    50% { transform: rotate(-4deg) translateY(-5px); }
  }

  @keyframes psCardFloat {
    0%, 100% { transform: rotate(4deg) translateY(0); }
    50% { transform: rotate(2.5deg) translateY(-6px); }
  }

  /* Center Headline Box */
  #petssify-hero-{{ section.id }} .ps-hero-headline-box {
    text-align: center;
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  /* Single pulsing dot Eyebrow Pill */
  #petssify-hero-{{ section.id }} .ps-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #090D16;
    color: #FFFFFF;
    border: 1.5px solid rgba(255, 107, 0, 0.6);
    border-radius: 999px;
    padding: 7px 18px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 14px;
    box-shadow: 0 6px 18px rgba(9, 13, 22, 0.14);
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--ps-accent);
    box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.28);
    display: inline-block;
    flex-shrink: 0;
    animation: psEyebrowPulse 2s infinite;
  }

  @keyframes psEyebrowPulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.28); }
    50% { box-shadow: 0 0 0 6px rgba(255, 107, 0, 0); }
  }

  #petssify-hero-{{ section.id }} .ps-hero-title {
    margin: 0;
    color: var(--ps-heading-color);
    font-size: clamp(48px, 7.8vw, 118px);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.035em;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-title-line {
    display: block;
  }

  #petssify-hero-{{ section.id }} .ps-mobile-bf-pills {
    display: none;
  }

  /* ZONE B: 3-Column Bottom Bento Bar */
  #petssify-hero-{{ section.id }} .ps-bento-bar-outer {
    position: relative;
    z-index: 2;
    width: 100%;
    background: linear-gradient(
      90deg,
      var(--ps-side-bg) 0%,
      var(--ps-side-bg) 33%,
      var(--ps-center-bg) 33%,
      var(--ps-center-bg) 67%,
      var(--ps-side-bg) 67%,
      var(--ps-side-bg) 100%
    );
  }

  #petssify-hero-{{ section.id }} .ps-bento-grid {
    max-width: var(--ps-max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.14fr) minmax(0, 1fr);
    align-items: stretch;
    gap: 0;
  }

  #petssify-hero-{{ section.id }} .ps-bento-card {
    position: relative;
    overflow: visible;
    min-height: 215px;
    padding: 48px 20px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  /* High contrast: Deep Obsidian Navy text on Sky-Blue Cards (Bug #4 Fix) */
  #petssify-hero-{{ section.id }} .ps-bento-card--side {
    background-color: var(--ps-side-bg);
    color: #090D16 !important;
  }

  /* Center Card: Deep Gradient + Proper Breathing Room (Bug #5 Fix) */
  #petssify-hero-{{ section.id }} .ps-bento-card--center {
    background: linear-gradient(180deg, #090D16 0%, #0A2540 100%) !important;
    color: var(--ps-center-text);
    border-top: 3.5px solid var(--ps-accent);
    min-height: 215px !important;
    padding: 48px 24px 36px !important;
    z-index: 3;
  }

  /* CARD-TOP LEDGE ANCHOR (Bug #3 Fix: 66% on Left/Right, 71% Center) */
  #petssify-hero-{{ section.id }} .ps-pet-wrap {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 5;
    pointer-events: none;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  #petssify-hero-{{ section.id }} .ps-pet-wrap--left {
    width: calc(var(--ps-left-w) * 1%);
    max-width: 340px;
    transform: translate(-50%, calc(-1% * var(--ps-left-ledge)));
  }

  #petssify-hero-{{ section.id }} .ps-pet-wrap--center {
    width: calc(var(--ps-center-w) * 1%);
    max-width: 460px;
    transform: translate(-50%, calc(-1% * var(--ps-center-ledge)));
  }

  #petssify-hero-{{ section.id }} .ps-pet-wrap--right {
    width: calc(var(--ps-right-w) * 1%);
    max-width: 340px;
    transform: translate(-50%, calc(-1% * var(--ps-right-ledge)));
  }

  #petssify-hero-{{ section.id }} .ps-pet-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  /* Card Content */
  #petssify-hero-{{ section.id }} .ps-card-content {
    position: relative;
    z-index: 6;
    max-width: 300px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  #petssify-hero-{{ section.id }} .ps-stat-inline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  #petssify-hero-{{ section.id }} .ps-stat-big {
    font-size: clamp(30px, 3vw, 46px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #090D16 !important;
