<script>
  (function() {
    var wrap = document.querySelector('#petssify-hero-{{ section.id }} [data-hero-bf-timer]');
    if (!wrap) return;
    var key = 'petssify_bfcm_deadline_v4';
    var endStr = wrap.getAttribute('data-end-date');
    var target = endStr ? new Date(endStr).getTime() : NaN;
    var now = Date.now();

    if (isNaN(target) || target <= now || (target - now) > (4 * 86400000)) {
      var saved = localStorage.getItem(key);
      if (saved && parseInt(saved, 10) > now) {
        target = parseInt(saved, 10);
      } else {
        target = now + (2 * 86400000) + (14 * 3600000) + (37 * 60000) + 56000;
        localStorage.setItem(key, String(target));
      }
    }

    var dEl = wrap.querySelector('[data-d]');
    var hEl = wrap.querySelector('[data-h]');
    var mEl = wrap.querySelector('[data-m]');
    var sEl = wrap.querySelector('[data-s]');

    function tick() {
      var diff = Math.max(0, target - Date.now());
      if (dEl) dEl.textContent = String(Math.floor(diff / 86400000)).padStart(2, '0');
      if (hEl) hEl.textContent = String(Math.floor((diff % 86400000) / 3600000)).padStart(2, '0');
      if (mEl) mEl.textContent = String(Math.floor((diff % 3600000) / 60000)).padStart(2, '0');
      if (sEl) sEl.textContent = String(Math.floor((diff % 60000) / 1000)).padStart(2, '0');
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>

