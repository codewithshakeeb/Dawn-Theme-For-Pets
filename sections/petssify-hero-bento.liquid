{% comment %}
  Petssify 3D Bento Hero — Exact Match to Reference Mockup (image_ac7e5b.jpg)
  - Top-Left: Upright Black Friday "UP TO 70% OFF" Card with Orange Price Tag SVG & Side Rays
  - Top-Right: Upright "BLACK FRIDAY DEAL ENDS IN" Card with 4 Orange Digit Boxes & Labels
  - Center Headline: "Everything / Your Pets Love" with Hand-Drawn Orange Heart SVG & Sky Paw Watermarks
  - Bottom Bento Bar: Rounded Obsidian-Navy Center Card with Orange Paw Icon + "Up to 70% OFF" in Orange
{% endcomment %}

<section
  id="petssify-hero-{{ section.id }}"
  class="ps-hero-section"
  style="
    --ps-upper-bg: {{ section.settings.upper_bg_color | default: '#EBF3FE' }};
    --ps-heading-color: {{ section.settings.heading_color | default: '#0B1320' }};
    --ps-side-bg: {{ section.settings.side_cards_bg_color | default: '#B7D2F7' }};
    --ps-side-text: {{ section.settings.side_cards_text_color | default: '#0B1320' }};
    --ps-center-bg: {{ section.settings.center_card_bg_color | default: '#0B1320' }};
    --ps-center-text: {{ section.settings.center_card_text_color | default: '#FFFFFF' }};
    --ps-accent: {{ section.settings.accent_orange_color | default: '#FF6B00' }};
    --ps-h1-desktop: {{ section.settings.heading_size_desktop | default: 96 }}px;
    --ps-h1-mobile: {{ section.settings.heading_size_mobile | default: 42 }}px;
    --ps-stage-space: {{ section.settings.upper_stage_space | default: 235 }}px;
    --ps-left-w: {{ section.settings.left_pet_width_pct | default: 72 }};
    --ps-left-ledge: {{ section.settings.left_pet_ledge_pct | default: 66 }};
    --ps-center-w: {{ section.settings.center_pet_width_pct | default: 84 }};
    --ps-center-ledge: {{ section.settings.center_pet_ledge_pct | default: 71 }};
    --ps-right-w: {{ section.settings.right_pet_width_pct | default: 70 }};
    --ps-right-ledge: {{ section.settings.right_pet_ledge_pct | default: 66 }};
    --ps-max-w: {{ section.settings.container_max_width | default: '1680px' }};
  "
>
  <!-- ZONE A: Upper Sky Stage, Floating Left/Right Cards, Paw Watermarks & Giant Headline -->
  <div class="ps-hero-upper">
    <div class="ps-hero-container">

      <!-- Subtle Sky-Blue Decorative Paw Watermarks -->
      <span class="ps-bg-paw ps-bg-paw--left" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="32" cy="42" rx="14" ry="11"/>
          <circle cx="16" cy="26" r="6"/>
          <circle cx="26" cy="18" r="6"/>
          <circle cx="38" cy="18" r="6"/>
          <circle cx="48" cy="26" r="6"/>
        </svg>
      </span>
      <span class="ps-bg-paw ps-bg-paw--right" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="32" cy="42" rx="14" ry="11"/>
          <circle cx="16" cy="26" r="6"/>
          <circle cx="26" cy="18" r="6"/>
          <circle cx="38" cy="18" r="6"/>
          <circle cx="48" cy="26" r="6"/>
        </svg>
      </span>

      {% if section.settings.enable_bf_widgets %}
        <!-- TOP-LEFT FLOATING WIDGET: "BLACK FRIDAY UP TO 70% OFF" CARD -->
        <div class="ps-bf-left-box">
          <!-- Left Orange Burst Rays -->
          <svg class="ps-burst-rays ps-burst-rays--left" viewBox="0 0 24 48" fill="none" aria-hidden="true">
            <line x1="20" y1="10" x2="4" y2="4" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="18" y1="24" x2="2" y2="24" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="20" y1="38" x2="4" y2="44" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
          </svg>

          <div class="ps-left-card-inner">
            <div class="ps-lc-header">
              <!-- Orange Price Tag SVG Icon -->
              <svg class="ps-lc-tag-svg" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M16.5 3H6C4.34315 3 3 4.34315 3 6V16.5C3 17.2956 3.31607 18.0587 3.87868 18.6213L15.3787 30.1213C16.5503 31.2929 18.4497 31.2929 19.6213 30.1213L30.1213 19.6213C31.2929 18.4497 31.2929 16.5503 30.1213 15.3787L18.6213 3.87868C18.0587 3.31607 17.2956 3 16.5 3Z" fill="#FF6B00"/>
                <circle cx="9.5" cy="9.5" r="2.2" fill="#0B111E"/>
                <line x1="13" y1="18" x2="20" y2="11" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
                <line x1="16" y1="21" x2="23" y2="14" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <span class="ps-lc-title">{{ section.settings.left_box_title | default: 'BLACK FRIDAY' }}</span>
            </div>
            <div class="ps-lc-upto">{{ section.settings.left_box_top | default: 'UP TO' }}</div>
            <div class="ps-lc-big">{{ section.settings.left_box_stat | default: '70%' }}</div>
            <div class="ps-lc-off">{{ section.settings.left_box_bottom | default: 'OFF' }}</div>
          </div>

          <!-- Right Orange Burst Rays -->
          <svg class="ps-burst-rays ps-burst-rays--right" viewBox="0 0 24 48" fill="none" aria-hidden="true">
            <line x1="4" y1="10" x2="20" y2="4" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="6" y1="24" x2="22" y2="24" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="4" y1="38" x2="20" y2="44" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>

        <!-- TOP-RIGHT FLOATING WIDGET: "BLACK FRIDAY DEAL ENDS IN" 4-ORANGE-BOX TIMER -->
        <div class="ps-bf-right-box" data-hero-bf-timer data-end-date="{{ section.settings.bf_end_date }}">
          <div class="ps-rc-top">
            <span class="ps-rc-clock-circle" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="10" cy="10" r="9" fill="#FF6B00"/>
                <path d="M10 5.5V10L13 12" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="ps-rc-deal-white">{{ section.settings.right_box_title | default: 'BLACK FRIDAY DEAL' }}</span>
            <span class="ps-rc-deal-orange">{{ section.settings.right_box_accent | default: 'ENDS IN' }}</span>
          </div>

          <div class="ps-rc-grid" data-hero-clock>
            <div class="ps-rc-col">
              <div class="ps-rc-orange-box" data-d>02</div>
              <span class="ps-rc-unit-label">Days</span>
            </div>
            <div class="ps-rc-col">
              <div class="ps-rc-orange-box" data-h>14</div>
              <span class="ps-rc-unit-label">Hours</span>
            </div>
            <div class="ps-rc-col">
              <div class="ps-rc-orange-box" data-m>37</div>
              <span class="ps-rc-unit-label">Minutes</span>
            </div>
            <div class="ps-rc-col">
              <div class="ps-rc-orange-box" data-s>56</div>
              <span class="ps-rc-unit-label">Seconds</span>
            </div>
          </div>

          <!-- Outer Right Orange Burst Rays -->
          <svg class="ps-burst-rays ps-burst-rays--far-right" viewBox="0 0 24 48" fill="none" aria-hidden="true">
            <line x1="4" y1="10" x2="20" y2="4" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="6" y1="24" x2="22" y2="24" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="4" y1="38" x2="20" y2="44" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
      {% endif %}

      <!-- CENTER GIANT 2-LINE HEADLINE + ORANGE HEART DOODLE -->
      <div class="ps-hero-headline-box">
        <{{ section.settings.heading_tag | default: 'h1' }} class="ps-hero-title">
          {% if section.settings.heading_line_1 != blank %}
            <span class="ps-title-line">{{ section.settings.heading_line_1 | escape }}</span>
          {% endif %}
          {% if section.settings.heading_line_2 != blank %}
            <span class="ps-title-line ps-title-line--second">
              {{ section.settings.heading_line_2 | escape }}
              <!-- Hand-Drawn Orange Heart + Rays SVG Next to "Love" -->
              <svg class="ps-love-heart-svg" viewBox="0 0 56 52" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M24 38C24 38 10 29 10 19C10 13.5 14.5 10 19 10C22 10 24 12 24 14.5C24 12 26 10 29 10C33.5 10 38 13.5 38 19C38 29 24 38 24 38Z" stroke="#FF6B00" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <line x1="6" y1="8" x2="2" y2="4" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="44" y1="10" x2="50" y2="6" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="46" y1="22" x2="53" y2="22" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="42" y1="34" x2="48" y2="38" stroke="#FF6B00" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
            </span>
          {% endif %}
        </{{ section.settings.heading_tag | default: 'h1' }}>
      </div>

    </div>
  </div>

  <!-- ZONE B: 3-Column Bottom Bento Bar -->
  <div class="ps-bento-bar-outer">
    <div class="ps-bento-grid">

      <!-- COLUMN 1: LEFT SOCIAL PROOF CARD + LEFT PEEKING DACHSHUND -->
      <div class="ps-bento-card ps-bento-card--side ps-bento-card--left {% unless section.settings.show_side_pets_on_mobile %}ps-hide-side-pet-mobile{% endunless %}">
        <div class="ps-pet-wrap ps-pet-wrap--left">
          {% if section.settings.left_pet_image != blank %}
            {{
              section.settings.left_pet_image
              | image_url: width: 800
              | image_tag:
                loading: 'eager',
                widths: '260, 380, 520, 800',
                sizes: '(max-width: 767px) 42vw, (max-width: 1200px) 24vw, 340px',
                alt: section.settings.left_pet_alt,
                class: 'ps-pet-img'
            }}
          {% endif %}
        </div>

        <div class="ps-card-content">
          <div class="ps-stat-inline">
            {% if section.settings.left_stat_number != blank %}
              <span class="ps-stat-big">{{ section.settings.left_stat_number | escape }}</span>
            {% endif %}
            <div class="ps-avatars">
              {% if section.settings.left_avatar_1 != blank %}
                {{
                  section.settings.left_avatar_1
                  | image_url: width: 100
                  | image_tag:
                    loading: 'lazy',
                    width: 40,
                    height: 40,
                    alt: 'Happy customer',
                    class: 'ps-avatar-circle'
                }}
              {% endif %}
              {% if section.settings.left_avatar_2 != blank %}
                {{
                  section.settings.left_avatar_2
                  | image_url: width: 100
                  | image_tag:
                    loading: 'lazy',
                    width: 40,
                    height: 40,
                    alt: 'Happy pet',
                    class: 'ps-avatar-circle'
                }}
              {% endif %}
              {% if section.settings.left_badge_text != blank %}
                <span class="ps-plus-circle">{{ section.settings.left_badge_text | escape }}</span>
              {% endif %}
            </div>
          </div>
          {% if section.settings.left_card_subtext != blank %}
            <p class="ps-card-caption">{{ section.settings.left_card_subtext | newline_to_br }}</p>
          {% endif %}
        </div>
      </div>

      <!-- COLUMN 2: CENTER ROUNDED OBSIDIAN-NAVY CARD + CENTER GOLDEN RETRIEVER -->
      <div class="ps-bento-card ps-bento-card--center-wrap">
        <div class="ps-pet-wrap ps-pet-wrap--center">
          {% if section.settings.center_pet_image != blank %}
            {{
              section.settings.center_pet_image
              | image_url: width: 1100
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '340, 480, 680, 900, 1100',
                sizes: '(max-width: 767px) 70vw, (max-width: 1200px) 32vw, 460px',
                alt: section.settings.center_pet_alt,
                class: 'ps-pet-img'
            }}
          {% endif %}
        </div>

        <div class="ps-bento-card--center-box">
          <div class="ps-card-content ps-card-content--center">
            <!-- Orange Paw Icon Between the Dog's Paws -->
            <span class="ps-center-paw-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="16" cy="21" rx="7" ry="5.5"/>
                <circle cx="8" cy="13" r="3"/>
                <circle cx="13" cy="9" r="3"/>
                <circle cx="19" cy="9" r="3"/>
                <circle cx="24" cy="13" r="3"/>
              </svg>
            </span>

            <h2 class="ps-cta-heading">
              <span class="ps-cta-line-1">{{ section.settings.center_line_1 | default: 'Black Friday Sale' }}</span>
              <span class="ps-cta-line-2">
                <span class="ps-cta-upto">{{ section.settings.center_line_2_white | default: 'Up to ' }}</span>
                <span class="ps-cta-orange">{{ section.settings.center_line_2_orange | default: '70% OFF' }}</span>
              </span>
            </h2>

            {% if section.settings.cta_button_label != blank %}
              <a href="{{ section.settings.cta_button_link | default: '/collections/all' }}" class="ps-cta-btn">
                <span>{{ section.settings.cta_button_label | escape }}</span>
                <span class="ps-cta-arrow" aria-hidden="true">
                  <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.16669 10H15.8334M15.8334 10L10.8334 5M15.8334 10L10.8334 15" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- COLUMN 3: RIGHT RATING CARD + RIGHT PEEKING CAT -->
      <div class="ps-bento-card ps-bento-card--side ps-bento-card--right {% unless section.settings.show_side_pets_on_mobile %}ps-hide-side-pet-mobile{% endunless %}">
        <div class="ps-pet-wrap ps-pet-wrap--right">
          {% if section.settings.right_pet_image != blank %}
            {{
              section.settings.right_pet_image
              | image_url: width: 800
              | image_tag:
                loading: 'eager',
                widths: '260, 380, 520, 800',
                sizes: '(max-width: 767px) 42vw, (max-width: 1200px) 24vw, 340px',
                alt: section.settings.right_pet_alt,
                class: 'ps-pet-img'
            }}
          {% endif %}
        </div>

        <div class="ps-card-content">
          <div class="ps-stat-inline">
            {% if section.settings.right_rating_value != blank %}
              <span class="ps-stat-big">{{ section.settings.right_rating_value | escape }}</span>
            {% endif %}
            {% if section.settings.show_star_icon %}
              <span class="ps-star-svg" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2.25L14.91 8.15L21.42 9.1L16.71 13.69L17.82 20.17L12 17.11L6.18 20.17L7.29 13.69L2.58 9.1L9.09 8.15L12 2.25Z"/>
                </svg>
              </span>
            {% endif %}
          </div>
          {% if section.settings.right_card_subtext != blank %}
            <p class="ps-card-caption">{{ section.settings.right_card_subtext | newline_to_br }}</p>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #petssify-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: 100vw;
    background-color: var(--ps-upper-bg);
    overflow: hidden;
    box-sizing: border-box;
  }

  #petssify-hero-{{ section.id }} *,
  #petssify-hero-{{ section.id }} *::before,
  #petssify-hero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* ZONE A: Upper Sky Stage */
  #petssify-hero-{{ section.id }} .ps-hero-upper {
    position: relative;
    z-index: 1;
    padding-top: clamp(24px, 3.2vw, 46px);
    padding-bottom: clamp(140px, calc(var(--ps-stage-space) * 0.85), var(--ps-stage-space));
  }

  #petssify-hero-{{ section.id }} .ps-hero-container {
    position: relative;
    max-width: var(--ps-max-w);
    margin: 0 auto;
    padding: 0 clamp(16px, 3.5vw, 44px);
  }

  /* Decorative Sky-Blue Paw Watermarks */
  #petssify-hero-{{ section.id }} .ps-bg-paw {
    position: absolute;
    width: clamp(38px, 3.4vw, 50px);
    height: clamp(38px, 3.4vw, 50px);
    color: #9EC3F5;
    opacity: 0.72;
    pointer-events: none;
    z-index: 1;
  }

  #petssify-hero-{{ section.id }} .ps-bg-paw--left {
    left: 28%;
    bottom: -50px;
    transform: rotate(-18deg);
  }

  #petssify-hero-{{ section.id }} .ps-bg-paw--right {
    right: 28%;
    bottom: -52px;
    transform: rotate(16deg);
  }

  /* TOP-LEFT FLOATING "BLACK FRIDAY UP TO 70% OFF" CARD */
  #petssify-hero-{{ section.id }} .ps-bf-left-box {
    position: absolute;
    left: clamp(24px, 4.5vw, 76px) !important;
    right: auto !important;
    top: 6px !important;
    z-index: 4;
    display: flex;
    align-items: center;
  }

  #petssify-hero-{{ section.id }} .ps-left-card-inner {
    background-color: #0B111E;
    border: 2px solid #FF6B00;
    border-radius: 18px;
    padding: 16px 22px 14px;
    min-width: 212px;
    box-shadow: 0 18px 36px rgba(11, 17, 30, 0.24);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #petssify-hero-{{ section.id }} .ps-lc-header {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  #petssify-hero-{{ section.id }} .ps-lc-tag-svg {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }

  #petssify-hero-{{ section.id }} .ps-lc-title {
    font-size: 16px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 0.02em;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-lc-upto {
    font-size: 17px;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.1;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-lc-big {
    font-size: 56px;
    font-weight: 900;
    color: #FF6B00;
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin: 2px 0;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-lc-off {
    font-size: 20px;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-burst-rays {
    width: 22px;
    height: 44px;
    position: absolute;
    pointer-events: none;
  }

  #petssify-hero-{{ section.id }} .ps-burst-rays--left {
    left: -24px;
    bottom: 16px;
  }

  #petssify-hero-{{ section.id }} .ps-burst-rays--right {
    right: -24px;
    bottom: 16px;
  }

  #petssify-hero-{{ section.id }} .ps-burst-rays--far-right {
    right: -24px;
    top: 32%;
  }

  /* TOP-RIGHT FLOATING "BLACK FRIDAY DEAL ENDS IN" 4-BOX TIMER CARD */
  #petssify-hero-{{ section.id }} .ps-bf-right-box {
    position: absolute;
    right: clamp(24px, 4.5vw, 76px) !important;
    left: auto !important;
    top: 14px !important;
    z-index: 4;
    background-color: #0B111E;
    border-radius: 18px;
    padding: 16px 20px 14px;
    box-shadow: 0 18px 36px rgba(11, 17, 30, 0.24);
  }

  #petssify-hero-{{ section.id }} .ps-rc-top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-bottom: 11px;
  }

  #petssify-hero-{{ section.id }} .ps-rc-clock-circle {
    width: 20px;
    height: 20px;
    display: inline-flex;
  }

  #petssify-hero-{{ section.id }} .ps-rc-deal-white {
    font-size: 12.5px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 0.03em;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-rc-deal-orange {
    font-size: 12.5px;
    font-weight: 800;
    color: #FF6B00;
    letter-spacing: 0.03em;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-rc-grid {
    display: grid;
    grid-template-columns: repeat(4, 50px);
    gap: 10px;
    justify-content: center;
  }

  #petssify-hero-{{ section.id }} .ps-rc-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #petssify-hero-{{ section.id }} .ps-rc-orange-box {
    width: 50px;
    height: 48px;
    border-radius: 10px;
    background-color: #FF6B00;
    color: #FFFFFF;
    font-size: 22px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  #petssify-hero-{{ section.id }} .ps-rc-unit-label {
    font-size: 11px;
    font-weight: 600;
    color: #FFFFFF;
    margin-top: 5px;
    font-family: var(--font-body, 'Inter', sans-serif);
  }

  /* Center Giant Headline */
  #petssify-hero-{{ section.id }} .ps-hero-headline-box {
    text-align: center;
    max-width: 980px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  #petssify-hero-{{ section.id }} .ps-hero-title {
    margin: 0;
