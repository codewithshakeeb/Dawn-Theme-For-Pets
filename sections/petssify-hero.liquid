{%- comment -%}
  Petssify Modern Hero Section
  Matches Base44 Prototype (Spec 2.2)
{%- endcomment -%}

{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

<section class="petssify-hero color-{{ section.settings.color_scheme }}" style="position: relative; background-color: var(--color-primary); color: #FFFFFF; overflow: hidden; min-height: 580px; display: flex; align-items: center; padding: 64px 0;">
  {%- if section.settings.image != blank -%}
    <div class="petssify-hero__bg" style="position: absolute; inset: 0; z-index: 0;">
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        loading="eager"
        fetchpriority="high"
        width="2000"
        height="1000"
        style="width: 100%; height: 100%; object-fit: cover; object-position: center; opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};"
      >
      <div style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15, 23, 42, 0.92) 0%, rgba(15, 23, 42, 0.75) 50%, rgba(15, 23, 42, 0.4) 100%);"></div>
    </div>
  {%- endif -%}

  <div class="page-width" style="position: relative; z-index: 1; width: 100%;">
    <div style="max-width: 680px;">
      {%- if section.settings.badge_text != blank -%}
        <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(13, 148, 136, 0.2); border: 1px solid rgba(13, 148, 136, 0.4); border-radius: var(--radius-full); padding: 6px 14px; margin-bottom: 20px;">
          <span style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--color-accent);"></span>
          <span style="font-family: var(--font-heading); font-size: 13px; font-weight: 700; color: #FFFFFF; letter-spacing: 0.02em;">
            {{ section.settings.badge_text }}
          </span>
        </div>
      {%- endif -%}

      <h1 style="font-family: var(--font-heading); font-size: clamp(32px, 4.5vw, 52px); font-weight: 800; line-height: 1.15; color: #FFFFFF; margin: 0 0 16px 0; text-wrap: balance;">
        {{ section.settings.heading }}
      </h1>

      <p style="font-family: var(--font-body); font-size: clamp(15px, 1.8vw, 17px); line-height: 1.6; color: #E2E8F0; margin: 0 0 28px 0;">
        {{ section.settings.subheading }}
      </p>

      <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 32px;">
        {%- if section.settings.primary_button_label != blank -%}
          <a href="{{ section.settings.primary_button_link }}" class="button button--primary" style="padding: 14px 28px; font-size: 15px;">
            {{ section.settings.primary_button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a href="{{ section.settings.secondary_button_link }}" class="button button--secondary" style="padding: 14px 28px; font-size: 15px; background: rgba(255, 255, 255, 0.1) !important; color: #FFFFFF !important; border-color: rgba(255, 255, 255, 0.2) !important;">
            {{ section.settings.secondary_button_label }}
          </a>
        {%- endif -%}
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 20px; font-size: 13px; color: #CBD5E1; border-top: 1px solid rgba(255, 255, 255, 0.12); padding-top: 20px;">
        <span style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Verified Sizing Specs
        </span>
        <span style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          30-Day Money-Back Guarantee
        </span>
        <span style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Free US Shipping Over $50
        </span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Petssify Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image Opacity",
      "default": 45
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Verified Sizing & Specs on Every Product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Practical Dog & Cat Supplies — Verified Sizing, Materials & Breed Specs"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop 304 stainless steel water fountains, whisper-quiet LED nail grinders, interactive puzzle toys, escape-proof harnesses, and post-surgery recovery gear—with exact measurements in inches and centimeters before you buy."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary Button Label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary Button Link",
      "default": "/collections/best-sellers"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Label",
      "default": "Explore All Products"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link",
      "default": "/collections/all"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-be67989a-20c9-42ec-9bd1-c4b22c355695"
    }
  ],
  "presets": [
    {
      "name": "Petssify Hero Banner"
    }
  ]
}
{% endschema %}
