<style>
  #shopify-section-{{ section.id }} .petssify-faq-wrapper {
    padding: 64px 20px;
    background-color: #F8FAFC;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .petssify-faq-card {
    max-width: 1200px;
    margin: 0 auto;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 28px;
    padding: 56px 48px;
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.03);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .petssify-faq-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 52px;
    align-items: start;
  }

  /* Left Column */
  #shopify-section-{{ section.id }} .petssify-faq__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    background: #EEF2FF;
    color: #4F46E5;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .petssify-faq__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #4F46E5;
    display: inline-block;
  }

  #shopify-section-{{ section.id }} .petssify-faq__heading {
    font-family: var(--font-heading, -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 38px;
    font-weight: 800;
    color: #00205B;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 16px 0;
  }

  #shopify-section-{{ section.id }} .petssify-faq__subheading {
    font-size: 15px;
    color: #64748B;
    line-height: 1.6;
    margin: 0 0 32px 0;
  }

  #shopify-section-{{ section.id }} .petssify-faq__ask-card {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 18px;
    padding: 24px;
    margin-top: 16px;
  }

  #shopify-section-{{ section.id }} .petssify-faq__ask-title {
    font-family: var(--font-heading, -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 17px;
    font-weight: 700;
    color: #0F172A;
    margin: 0 0 6px 0;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .petssify-faq__ask-desc {
    font-size: 13px;
    color: #64748B;
    line-height: 1.5;
    margin: 0 0 18px 0;
  }

  #shopify-section-{{ section.id }} .petssify-faq__ask-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    background-color: #00205B;
    color: #FFFFFF;
    font-family: var(--font-heading, -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 14px;
    font-weight: 700;
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 3px 10px rgba(0, 32, 91, 0.2);
  }

  #shopify-section-{{ section.id }} .petssify-faq__ask-btn:hover {
    background-color: #0B1F5C;
    transform: translateY(-1px);
    box-shadow: 0 5px 14px rgba(0, 32, 91, 0.28);
    color: #FFFFFF;
  }

  /* Right Column (FAQ List) */
  #shopify-section-{{ section.id }} .petssify-faq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .petssify-faq__item {
    background-color: #F8FAFC;
    border: 1px solid transparent;
    border-radius: 14px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .petssify-faq__item:hover {
    background-color: #F1F5F9;
  }

  #shopify-section-{{ section.id }} .petssify-faq__item.is-open {
    background-color: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  #shopify-section-{{ section.id }} .petssify-faq__question {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 20px 22px;
    text-align: left;
    font-family: inherit;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .petssify-faq__num {
    font-family: var(--font-heading, -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 14px;
    font-weight: 600;
    color: #94A3B8;
    min-width: 26px;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .petssify-faq__title {
    font-family: var(--font-heading, -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 15px;
    font-weight: 700;
    color: #0F172A;
    line-height: 1.4;
    flex: 1;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .petssify-faq__toggle {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0F172A;
    position: relative;
  }

  #shopify-section-{{ section.id }} .petssify-faq__toggle-icon {
    width: 14px;
    height: 14px;
    position: relative;
  }

  #shopify-section-{{ section.id }} .petssify-faq__toggle-icon::before,
  #shopify-section-{{ section.id }} .petssify-faq__toggle-icon::after {
    content: '';
    position: absolute;
    background-color: currentColor;
    border-radius: 1px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  /* Horizontal line (always visible) */
  #shopify-section-{{ section.id }} .petssify-faq__toggle-icon::before {
    top: 6px;
    left: 0;
    width: 14px;
    height: 2px;
  }

  /* Vertical line (hidden when open -> produces minus) */
  #shopify-section-{{ section.id }} .petssify-faq__toggle-icon::after {
    top: 0;
    left: 6px;
    width: 2px;
    height: 14px;
  }

  #shopify-section-{{ section.id }} .petssify-faq__item.is-open .petssify-faq__toggle-icon::after {
    transform: rotate(90deg);
    opacity: 0;
  }

  #shopify-section-{{ section.id }} .petssify-faq__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #shopify-section-{{ section.id }} .petssify-faq__answer-inner {
    padding: 0 22px 22px 64px;
    color: #475569;
    line-height: 1.65;
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .petssify-faq__answer-inner p {
    margin: 0 0 12px 0;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .petssify-faq__answer-inner p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 899px) {
    #shopify-section-{{ section.id }} .petssify-faq-wrapper {
      padding: 40px 16px;
    }

    #shopify-section-{{ section.id }} .petssify-faq-card {
      padding: 32px 20px;
      border-radius: 20px;
    }

    #shopify-section-{{ section.id }} .petssify-faq-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    #shopify-section-{{ section.id }} .petssify-faq__heading {
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .petssify-faq__question {
      padding: 16px 16px;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .petssify-faq__answer-inner {
      padding: 0 16px 18px 54px;
    }
  }
</style>

<section class="petssify-faq-wrapper" id="petssify-faq-{{ section.id }}">
  <div class="petssify-faq-card">
    <div class="petssify-faq-grid">
      
      <!-- Left Column: Branding, Title, and Contact Us Card -->
      <div class="petssify-faq__left">
        <div class="petssify-faq__badge">
          <span class="petssify-faq__badge-dot" aria-hidden="true"></span>
          FAQ
        </div>

        {%- if section.settings.heading != blank -%}
          <h2 class="petssify-faq__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="petssify-faq__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <div class="petssify-faq__ask-card">
          <h3 class="petssify-faq__ask-title">Still have a question?</h3>
          <p class="petssify-faq__ask-desc">
            {%- if section.settings.contact_text != blank -%}
              {{ section.settings.contact_text }}
            {%- else -%}
              Can't find the answer you're looking for? Don't worry, our team is always free for consultation.
            {%- endif -%}
          </p>
          <a
            href="{% if section.settings.contact_url != blank %}{{ section.settings.contact_url }}{% elsif section.settings.contact_email != blank %}mailto:{{ section.settings.contact_email }}{% else %}/pages/contact{% endif %}"
            class="petssify-faq__ask-btn"
          >
            Contact Us
          </a>
        </div>
      </div>

      <!-- Right Column: Numbered Minimalist Accordion Cards -->
      <div class="petssify-faq__right">
        <div class="petssify-faq__list" role="region" aria-label="Questions and answers">
          {%- for block in section.blocks -%}
            <div class="petssify-faq__item" {{ block.shopify_attributes }}>
              <button
                class="petssify-faq__question"
                type="button"
                aria-expanded="false"
                aria-controls="petssify-faq-answer-{{ block.id }}"
                id="petssify-faq-question-{{ block.id }}"
              >
                <span class="petssify-faq__num" aria-hidden="true">
                  {%- if forloop.index < 10 -%}0{%- endif -%}{{ forloop.index }}
                </span>
                <span class="petssify-faq__title">{{ block.settings.question }}</span>
                <span class="petssify-faq__toggle" aria-hidden="true">
                  <span class="petssify-faq__toggle-icon"></span>
                </span>
              </button>
              <div
                class="petssify-faq__answer"
                id="petssify-faq-answer-{{ block.id }}"
                role="region"
                aria-labelledby="petssify-faq-question-{{ block.id }}"
              >
                <div class="petssify-faq__answer-inner">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('petssify-faq-{{ section.id }}');
    if (!section) return;

    var allowMultiple = {{ section.settings.allow_multiple_open | json }};
    var items = section.querySelectorAll('.petssify-faq__item');

    items.forEach(function (item) {
      var button = item.querySelector('.petssify-faq__question');
      var answer = item.querySelector('.petssify-faq__answer');

      button.addEventListener('click', function () {
        var isOpen = item.classList.contains('is-open');

        if (!allowMultiple) {
          items.forEach(function (other) {
            if (other !== item) {
              other.classList.remove('is-open');
              other.querySelector('.petssify-faq__question').setAttribute('aria-expanded', 'false');
              other.querySelector('.petssify-faq__answer').style.maxHeight = null;
            }
          });
        }

        if (isOpen) {
          item.classList.remove('is-open');
          button.setAttribute('aria-expanded', 'false');
          answer.style.maxHeight = null;
        } else {
          item.classList.add('is-open');
          button.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Petssify FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know before you shop with Petssify."
    },
    {
      "type": "checkbox",
      "id": "allow_multiple_open",
      "label": "Allow multiple questions open at once",
      "default": false
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Contact text",
      "default": "Don't worry we're free for consultation. Contact our friendly support team."
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact page link"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email",
      "default": "support@petssify.com"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question goes here"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Petssify FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "What products does Petssify sell?", "answer": "<p>Petssify offers practical pet supplies for cats and dogs, including toys, walking and training gear, grooming tools, feeding accessories, beds, comfort products, and travel essentials.</p>" } },
        { "type": "faq_item", "settings": { "question": "Do you ship internationally?", "answer": "<p>Currently, Petssify ships orders within the United States. Tracking information is provided for shipped orders.</p>" } },
        { "type": "faq_item", "settings": { "question": "How long does shipping take?", "answer": "<p>Orders are typically processed within 1&ndash;2 business days and delivered within 5&ndash;10 business days in the United States.</p>" } },
        { "type": "faq_item", "settings": { "question": "What is your return policy?", "answer": "<p>Petssify accepts eligible returns within 30 days of delivery. Items generally need to be unused and in their original condition and packaging. Please review our Refund Policy for exclusions and complete return requirements.</p>" } },
        { "type": "faq_item", "settings": { "question": "How do I know which product is right for my pet?", "answer": "<p>Each product page provides available specifications, sizing information, features, and usage details. Review these details carefully to choose the product that best fits your pet's needs.</p>" } },
        { "type": "faq_item", "settings": { "question": "How can I track my order?", "answer": "<p>Tracking information is emailed once your order ships. You can also use our order tracking page with the required order or tracking information. If your tracking information has not updated for several business days, contact our support team.</p>" } },
        { "type": "faq_item", "settings": { "question": "What payment methods do you accept?", "answer": "<p>Petssify accepts several payment methods, including major credit and debit cards, PayPal, Apple Pay, Google Pay, and Shop Pay. Available payment options may vary at checkout.</p>" } },
        { "type": "faq_item", "settings": { "question": "Do Petssify products have size or compatibility information?", "answer": "<p>Yes. When sizing or compatibility is relevant, the product page provides the available measurements, weight limits, dimensions, or other specifications to help you choose the appropriate product.</p>" } },
        { "type": "faq_item", "settings": { "question": "What if my item arrives damaged or defective?", "answer": "<p>If your order arrives damaged, defective, or incorrect, please contact our support team as soon as possible with your order details and photos of the issue so we can assist you.</p>" } },
        { "type": "faq_item", "settings": { "question": "How can I contact Petssify customer support?", "answer": "<p>You can contact Petssify at support@petssify.com. Our support team typically responds within 24 hours.</p>" } }
      ]
    }
  ]
}
{% endschema %}
