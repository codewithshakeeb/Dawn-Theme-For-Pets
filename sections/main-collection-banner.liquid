
<!-- Black Friday Global Header Strip on Collections -->
<div class="ps-collection-bfcm-strip">
  <div class="page-width ps-collection-bfcm-inner">
    <div class="ps-collection-bfcm-left">
      <span class="ps-collection-bfcm-tag">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
          <line x1="7" y1="7" x2="7.01" y2="7"></line>
        </svg>
        UP TO 70% OFF
      </span>
      <span class="ps-collection-bfcm-text">
        <strong>BLACK FRIDAY SALE LIVE NOW</strong> — UP TO 70% OFF ENTIRE WEBSITE + EXTRA 20% AUTO-APPLIED AT CHECKOUT
      </span>
    </div>
    <div class="ps-collection-bfcm-right">
      <span class="ps-collection-bfcm-pill">FREE US SHIPPING ON $50+</span>
    </div>
  </div>
</div>

<style>
  .ps-collection-bfcm-strip {
    background: linear-gradient(90deg, #090D16 0%, #00205B 100%);
    color: #FFFFFF;
    border-bottom: 2.5px solid #FF6B00;
    padding: 10px 0;
    font-size: 13px;
    letter-spacing: 0.02em;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }
  .ps-collection-bfcm-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ps-collection-bfcm-left {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .ps-collection-bfcm-tag {
    background: #FF6B00;
    color: #FFFFFF;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .ps-collection-bfcm-text {
    color: #F8FAFC;
    font-size: 13px;
  }
  .ps-collection-bfcm-text strong {
    color: #FFFFFF;
    font-weight: 800;
  }
  .ps-collection-bfcm-pill {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 3px 12px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #FFFFFF;
  }
  @media screen and (max-width: 749px) {
    .ps-collection-bfcm-strip {
      padding: 8px 0;
    }
    .ps-collection-bfcm-inner {
      justify-content: center;
      text-align: center;
    }
    .ps-collection-bfcm-left {
      justify-content: center;
    }
    .ps-collection-bfcm-right {
      display: none;
    }
    .ps-collection-bfcm-text {
      font-size: 12px;
    }
  }
</style>
{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
  .petssify-subcollection-chips::-webkit-scrollbar {
    height: 4px;
  }
  .petssify-subcollection-chips::-webkit-scrollbar-thumb {
    background: var(--color-border-dark);
    border-radius: var(--radius-full);
  }
{%- endstyle -%}

<div class="collection-hero{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient" style="padding-top: 18px; padding-bottom: 8px;">
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    
    <div class="collection-hero__text-wrapper">
      {%- comment -%} Petssify: Breadcrumbs placed directly above visual H1 {%- endcomment -%}
      <div class="petssify-collection-breadcrumb" style="margin-bottom: 8px;">
        {% render 'breadcrumbs', no_wrapper: true %}
      </div>

      {%- comment -%} Petssify: Clean H1 without "Collection: " prefix (Spec 4.1) {%- endcomment -%}
      <h1 class="collection-hero__title" style="font-size: clamp(24px, 3.2vw, 34px); font-weight: 800; color: var(--color-primary); line-height: 1.2; margin: 0 0 8px 0;">
        {{- collection.title | escape -}}
      </h1>

      {%- comment -%} Petssify: 820px readable intro text container (Spec 4.1) {%- endcomment -%}
      {%- if section.settings.show_collection_description and collection.description != blank -%}
        <div class="collection-hero__description rte" style="max-width: 820px; font-size: 15px; line-height: 1.6; color: #475569; margin-top: 8px; margin-bottom: 16px;">
          {{ collection.description }}
        </div>
      {%- endif -%}

      {%- comment -%} Petssify: Optional sub-collection filter chips {%- endcomment -%}
      {%- if section.settings.subcollections_menu != blank and linklists[section.settings.subcollections_menu].links.size > 0 -%}
        <nav class="petssify-subcollection-chips" aria-label="Subcollections" style="display: flex; gap: 8px; overflow-x: auto; padding: 6px 0 12px 0; margin-top: 8px;">
          {%- for link in linklists[section.settings.subcollections_menu].links -%}
            <a
              href="{{ link.url }}"
              class="petssify-chip{% if link.active %} is-active{% endif %}"
              style="display: inline-flex; align-items: center; white-space: nowrap; padding: 6px 16px; border-radius: var(--radius-full); font-size: 13px; font-weight: 600; text-decoration: none; border: 1px solid {% if link.active %}var(--color-primary){% else %}var(--color-border){% endif %}; background-color: {% if link.active %}var(--color-primary){% else %}#FFFFFF{% endif %}; color: {% if link.active %}#FFFFFF{% else %}var(--color-text-main){% endif %}; transition: all var(--transition-fast);"
            >
              {{ link.title }}
            </a>
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="collection-hero__image-container media gradient" style="border-radius: var(--radius-card); overflow: hidden; box-shadow: var(--shadow-md);">
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | default: collection.title | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
          style="border-radius: var(--radius-card);"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "link_list",
      "id": "subcollections_menu",
      "label": "Optional Sub-collections Menu"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
