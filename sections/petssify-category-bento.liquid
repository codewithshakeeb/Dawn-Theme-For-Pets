      "default": "Save on food, interactive toys, grooming essentials, and premium accessories"
    },
    {
      "type": "header",
      "content": "Mobile Display"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout",
      "options": [
        {
          "value": "carousel",
          "label": "Swipe Carousel with Peek (Recommended)"
        },
        {
          "value": "stack",
          "label": "Vertical Stack"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "header",
      "content": "Section Spacing"
