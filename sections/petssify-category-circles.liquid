{%- comment -%}
  Petssify Category Circles ("Who are you shopping for?")
  - Enhanced Desktop & Mobile Experience
  - Desktop: Premium circular story badges with smooth hover rings, scaling, and brand shadows
  - Mobile: Supports high-CTR Horizontal Swipe Carousel (Story style) or Symmetrical 3x2 Grid
  - Custom Pet Category Illustrations / Icons fallback (no generic Dawn placeholder bags!)
  - Clean alt texts with "- Petssify -" suffix stripped out
{%- endcomment -%}

<div
  id="petssify-categories-{{ section.id }}"
  class="petssify-categories section-{{ section.id }}-padding"
  style="
    --cat-pt: {{ section.settings.padding_top | default: 48 }}px;
    --cat-pb: {{ section.settings.padding_bottom | default: 36 }}px;
    --cat-size-desktop: {{ section.settings.circle_size_desktop | default: 120 }}px;
    --cat-size-mobile: {{ section.settings.circle_size_mobile | default: 80 }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="petssify-cat-header">
        <h2 class="petssify-cat-title">
          {{ section.settings.heading }}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p class="petssify-cat-subtitle">
            {{ section.settings.subheading }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="petssify-cat-track petssify-cat-track--{{ section.settings.mobile_layout | default: 'carousel' }}"
      id="PetssifyCatTrack-{{ section.id }}"
    >
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- assign title = block.settings.title | default: collection.title -%}
        {%- if title == blank -%}
          {%- case forloop.index -%}
            {%- when 1 -%}{%- assign title = "Dogs" -%}
            {%- when 2 -%}{%- assign title = "Cats" -%}
            {%- when 3 -%}{%- assign title = "Grooming & Care" -%}
            {%- when 4 -%}{%- assign title = "Feeding Essentials" -%}
            {%- when 5 -%}{%- assign title = "Interactive Toys" -%}
            {%- when 6 -%}{%- assign title = "Collars & Leashes" -%}
          {%- endcase -%}
        {%- endif -%}
        {%- assign clean_title = title | remove: '- Petssify -' | remove: 'Petssify -' | remove: 'Petssify' | strip -%}
        {%- assign image = block.settings.image | default: collection.featured_image -%}
        {%- assign url = block.settings.url | default: collection.url | default: '/collections/all' -%}

        <a
          href="{{ url }}"
          class="petssify-cat-item"
          {{ block.shopify_attributes }}
          aria-label="{{ clean_title | escape }}"
        >
          <!-- Circle Ring & Image Container -->
          <div class="petssify-cat-avatar petssify-cat-avatar--theme-{{ forloop.index }}">
            {%- if image != blank -%}
              <img
                src="{{ image | image_url: width: 320 }}"
                alt="{{ clean_title | escape }}"
                loading="lazy"
                width="160"
                height="160"
                class="petssify-cat-img"
              >
            {%- else -%}
              <!-- Handcrafted Pet Category Icon Fallback (Replaces generic Dawn placeholder bag) -->
              <div class="petssify-cat-icon-fallback petssify-cat-icon-fallback--{{ forloop.index }}">
                {%- case forloop.index -%}
                  {%- when 1 -%}
                    <!-- Dogs Icon -->
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M10 5.172C10 3.782 8.423 2.679 6.5 3c-2.823.47-4.113 6.006-4 7 .107.94 1.488 2.052 3 2l1.5-.5"/>
                      <path d="M14 5.172C14 3.782 15.577 2.679 17.5 3c2.823.47 4.113 6.006 4 7-.107.94-1.488 2.052-3 2l-1.5-.5"/>
                      <path d="M9 14v1a3 3 0 0 0 6 0v-1"/>
                      <path d="M7 10.5h.01M17 10.5h.01"/>
                      <path d="M12 11a1 1 0 0 1-1-1c0-.5.5-1 1-1s1 .5 1 1a1 1 0 0 1-1 1z"/>
                      <path d="M6 10c0 4.5 2.5 8 6 8s6-3.5 6-8-2.5-6-6-6-6 1.5-6 6z"/>
                    </svg>
                  {%- when 2 -%}
                    <!-- Cats Icon -->
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 5c-4.5 0-7 3-7 7 0 4 2.5 7 7 7s7-3 7-7c0-4-2.5-7-7-7z"/>
                      <path d="M5 8L3 3l5 2M19 8l2-5-5 2"/>
                      <path d="M9 12h.01M15 12h.01"/>
                      <path d="M12 14.5a1.5 1.5 0 0 1-1.5-1.5h3A1.5 1.5 0 0 1 12 14.5z"/>
                      <path d="M3 13h4M17 13h4M4 16l3-1M17 15l3 1"/>
                    </svg>
                  {%- when 3 -%}
                    <!-- Grooming & Care Icon -->
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 21a4 4 0 0 1-4-4V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v12a4 4 0 0 1-4 4zm0 0h10a4 4 0 0 0 4-4V9a2 2 0 0 0-2-2h-4"/>
                      <path d="M3 7h8M3 11h8M3 15h8"/>
                      <path d="M17 3l1 2 2 1-2 1-1 2-1-2-2-1 2-1 1-2z"/>
                    </svg>
                  {%- when 4 -%}
                    <!-- Feeding Essentials Icon -->
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 14c0 3.866 4.03 7 9 7s9-3.134 9-7H3z"/>
                      <ellipse cx="12" cy="14" rx="9" ry="3"/>
                      <path d="M9.5 7.5a1.5 1.5 0 0 1 0-3 1.5 1.5 0 0 1 2.5 1.2 1.5 1.5 0 0 1 2.5-1.2 1.5 1.5 0 0 1 0 3l-2.5 1.5L9.5 7.5z"/>
                    </svg>
                  {%- when 5 -%}
                    <!-- Interactive Toys Icon -->
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M12 3a9 9 0 0 1 9 9M3 12a9 9 0 0 0 9 9"/>
                      <path d="M6 6c3 3 3 9 0 12M18 6c-3 3-3 9 0 12"/>
                    </svg>
                  {%- when 6 -%}
                    <!-- Collars & Leashes Icon -->
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="8"/>
                      <path d="M12 16a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
                      <path d="M12 16v4M12 4v4M4 12h4M16 12h4"/>
                      <circle cx="12" cy="20" r="1.5"/>
                    </svg>
                  {%- else -%}
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="9"/>
                      <path d="M12 8v8M8 12h8"/>
                    </svg>
                {%- endcase -%}
              </div>
            {%- endif -%}
          </div>

          <!-- Category Label -->
          <span class="petssify-cat-label">
            {{ clean_title }}
          </span>
        </a>
      {%- endfor -%}
    </div>

    <!-- Mobile Scroll Progress Indicator (Visible in carousel mode) -->
    <div class="petssify-cat-scrollbar" aria-hidden="true">
      <div class="petssify-cat-scrollbar-thumb"></div>
    </div>
  </div>
</div>

<style>
  #petssify-categories-{{ section.id }} {
    padding-top: var(--cat-pt);
    padding-bottom: var(--cat-pb);
  }

  .petssify-cat-header {
    text-align: center;
    margin-bottom: clamp(28px, 3.5vw, 40px);
  }

  .petssify-cat-title {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 800;
    color: var(--color-primary, #00205B);
    letter-spacing: -0.025em;
    margin: 0 0 8px 0;
  }

  .petssify-cat-subtitle {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: clamp(14px, 1.4vw, 15px);
    color: var(--color-text-muted, #64748B);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.5;
  }

  /* Desktop Track Layout (Centred, spacious, responsive) */
  .petssify-cat-track {
    display: flex;
    gap: clamp(16px, 2.5vw, 36px);
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  /* Category Item Wrapper */
  .petssify-cat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    width: clamp(100px, 11vw, var(--cat-size-desktop));
    transition: transform 0.28s cubic-bezier(0.2, 0, 0.2, 1);
  }

  /* Circular Avatar Container with Ring Effect */
  .petssify-cat-avatar {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    border: 2.5px solid var(--color-border, #E2E8F0);
    background: #FFFFFF;
    margin-bottom: 12px;
    box-shadow: 0 4px 12px -2px rgba(0, 32, 91, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.28s cubic-bezier(0.2, 0, 0.2, 1);
  }

  .petssify-cat-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.2, 0, 0.2, 1);
  }

  /* Fallback Pet Category Duotone Badges */
  .petssify-cat-icon-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s ease;
  }

  /* Category 1: Dogs (Warm Amber / Orange) */
  .petssify-cat-icon-fallback--1 {
    background: linear-gradient(135deg, #FFF7ED 0%, #FFEDD5 100%);
    color: #EA580C;
  }

  /* Category 2: Cats (Soft Sky / Blue) */
  .petssify-cat-icon-fallback--2 {
    background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
    color: #2563EB;
  }

  /* Category 3: Grooming (Emerald / Mint) */
  .petssify-cat-icon-fallback--3 {
    background: linear-gradient(135deg, #F0FDF4 0%, #DCFCE7 100%);
    color: #16A34A;
  }

  /* Category 4: Feeding (Coral / Salmon) */
  .petssify-cat-icon-fallback--4 {
    background: linear-gradient(135deg, #FEF2F2 0%, #FEE2E2 100%);
    color: #DC2626;
  }

  /* Category 5: Toys (Violet / Purple) */
  .petssify-cat-icon-fallback--5 {
    background: linear-gradient(135deg, #FAF5FF 0%, #F3E8FF 100%);
    color: #9333EA;
  }

  /* Category 6: Collars & Leashes (Teal / Ocean) */
  .petssify-cat-icon-fallback--6 {
    background: linear-gradient(135deg, #F0FDFA 0%, #CCFBF1 100%);
    color: #0D9488;
  }

  /* Category Label Typography */
  .petssify-cat-label {
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
    font-size: clamp(13px, 1.1vw, 15px);
    font-weight: 700;
    color: var(--color-primary, #00205B);
    text-align: center;
    line-height: 1.3;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  /* Desktop Hover Micro-interactions */
  @media (hover: hover) {
    .petssify-cat-item:hover .petssify-cat-avatar {
      border-color: var(--color-accent, #FF7A29);
      box-shadow: 0 12px 24px -4px rgba(255, 122, 41, 0.24);
      transform: translateY(-4px);
    }
    .petssify-cat-item:hover .petssify-cat-img,
    .petssify-cat-item:hover .petssify-cat-icon-fallback {
      transform: scale(1.08);
    }
    .petssify-cat-item:hover .petssify-cat-label {
      color: var(--color-accent, #FF7A29);
      transform: translateY(-1px);
    }
  }

  /* Mobile Scrollbar indicator (hidden on desktop) */
  .petssify-cat-scrollbar {
    display: none;
  }

  /* =========================================================================
     MOBILE RESPONSIVE MODES (< 768px)
     ========================================================================= */
  @media screen and (max-width: 767px) {
    #petssify-categories-{{ section.id }} {
      padding-top: calc(var(--cat-pt) * 0.75);
      padding-bottom: calc(var(--cat-pb) * 0.75);
    }

    .petssify-cat-header {
      margin-bottom: 22px;
      padding: 0 8px;
    }

    /* MODE 1: Horizontal Swipe Carousel (Story Style) */
    .petssify-cat-track--carousel {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 16px;
      justify-content: flex-start;
      padding: 4px 20px 14px;
      margin: 0 -20px;
    }

    .petssify-cat-track--carousel::-webkit-scrollbar {
      display: none;
    }

    .petssify-cat-track--carousel .petssify-cat-item {
      flex: 0 0 var(--cat-size-mobile);
      width: var(--cat-size-mobile);
      scroll-snap-align: start;
    }

    .petssify-cat-track--carousel .petssify-cat-avatar {
      width: var(--cat-size-mobile);
      height: var(--cat-size-mobile);
      border-width: 2px;
      margin-bottom: 8px;
    }

    .petssify-cat-track--carousel .petssify-cat-label {
      font-size: 12.5px;
      line-height: 1.2;
    }

    /* Subtle Mobile Carousel Progress Bar */
    .petssify-cat-track--carousel + .petssify-cat-scrollbar {
      display: block;
      width: 70px;
      height: 3px;
      border-radius: 9999px;
      background: #E2E8F0;
      margin: 10px auto 0;
      position: relative;
      overflow: hidden;
    }

    .petssify-cat-scrollbar-thumb {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 35%;
      border-radius: 9999px;
      background: var(--color-primary, #00205B);
      transition: transform 0.1s ease-out;
    }

    /* MODE 2: Symmetrical 3-Column Grid (3x2) */
    .petssify-cat-track--grid_3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px 12px;
      justify-items: center;
      padding: 0 4px;
    }

    .petssify-cat-track--grid_3 .petssify-cat-item {
      width: 100%;
      max-width: 96px;
    }

    .petssify-cat-track--grid_3 .petssify-cat-avatar {
      width: clamp(68px, 18vw, 84px);
      height: clamp(68px, 18vw, 84px);
      margin-bottom: 8px;
      border-width: 2px;
    }

    .petssify-cat-track--grid_3 .petssify-cat-label {
      font-size: 12px;
      line-height: 1.25;
    }

    /* MODE 3: 2-Column Grid (Optional) */
    .petssify-cat-track--grid_2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 16px;
      justify-items: center;
    }

    .petssify-cat-track--grid_2 .petssify-cat-item {
      width: 100%;
      max-width: 110px;
    }
  }
</style>

<script>
  (function() {
    function initCategoryProgress() {
      const track = document.getElementById('PetssifyCatTrack-{{ section.id }}');
      if (!track || !track.classList.contains('petssify-cat-track--carousel')) return;
      const thumb = track.parentElement.querySelector('.petssify-cat-scrollbar-thumb');
      if (!thumb) return;

      track.addEventListener('scroll', function() {
        const maxScroll = track.scrollWidth - track.clientWidth;
        if (maxScroll <= 0) return;
        const progress = Math.min(1, Math.max(0, track.scrollLeft / maxScroll));
        const maxThumbMove = 100 - 35; // 35% thumb width
        thumb.style.transform = 'translateX(' + (progress * (70 * 0.65)) + 'px)';
      }, { passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCategoryProgress);
    } else {
      initCategoryProgress();
    }
  })();
</script>

{% schema %}
{
  "name": "Category Circles",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Who are you shopping for?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore curated essentials tailored by category and species"
    },
    {
      "type": "header",
      "content": "Mobile Layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Display Style",
      "options": [
        {
          "value": "carousel",
          "label": "Story-Style Swipe Carousel (Recommended)"
        },
        {
          "value": "grid_3",
          "label": "Symmetrical 3-Column Grid (3x2)"
        },
        {
          "value": "grid_2",
          "label": "2-Column Grid"
        }
      ],
      "default": "carousel",
      "info": "Swipe carousel creates high mobile engagement without pushing the page down."
    },
    {
      "type": "header",
      "content": "Circle Sizes"
    },
    {
      "type": "range",
      "id": "circle_size_desktop",
      "label": "Circle Size (Desktop)",
      "min": 90,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "circle_size_mobile",
      "label": "Circle Size (Mobile Carousel)",
      "min": 64,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Label (optional)"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Circles",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
