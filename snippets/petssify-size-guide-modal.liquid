{%- comment -%}
  Petssify Size & Fit Modal
  Displays dynamic sizing chart from metafield (if available)
  or standard Petssify verified sizing guide.
{%- endcomment -%}

<div id="PetssifySizeGuideModal" class="petssify-modal" role="dialog" aria-modal="true" aria-hidden="true" style="display: none; position: fixed; inset: 0; z-index: 1000; align-items: center; justify-content: center;">
  <div class="petssify-modal__backdrop" onclick="closeSizeGuideModal()" style="position: absolute; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(2px);"></div>
  <div class="petssify-modal__dialog" style="position: relative; background: #FFFFFF; border-radius: var(--radius-card); max-width: 620px; width: 90%; max-height: 85vh; overflow-y: auto; padding: 28px; box-shadow: var(--shadow-lg); z-index: 1;">
    <button type="button" class="petssify-modal__close" onclick="closeSizeGuideModal()" aria-label="Close" style="position: absolute; top: 16px; right: 16px; background: transparent; border: none; font-size: 20px; cursor: pointer; color: var(--color-text-muted);"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
    
    <div class="petssify-modal__header" style="margin-bottom: 20px; border-bottom: 1px solid var(--color-border); padding-bottom: 12px;">
      <h3 style="margin: 0; font-family: var(--font-heading); font-size: 20px; font-weight: 800; color: var(--color-primary);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block; vertical-align:-3px; margin-right:6px;">
          <path d="M21.3 15.3l-6.6 6.6c-.4.4-1 .4-1.4 0l-9.9-9.9c-.4-.4-.4-1 0-1.4l6.6-6.6c.4-.4 1-.4 1.4 0l9.9 9.9c.4.4.4 1 0 1.4z"></path>
          <line x1="8.5" y1="8.5" x2="10.5" y2="10.5"></line>
          <line x1="12" y1="12" x2="14" y2="14"></line>
          <line x1="15.5" y1="15.5" x2="17.5" y2="17.5"></line>
        </svg>Verified Sizing & Fit Guide
      </h3>
      <p style="margin: 4px 0 0 0; font-size: 13px; color: var(--color-text-muted);">
        Every listing includes measured dimensions in inches and centimeters.
      </p>
    </div>

    <div class="petssify-modal__body">
      {%- if product.metafields.custom.size_guide != blank -%}
        <div class="rte">
          {{ product.metafields.custom.size_guide }}
        </div>
      {%- else -%}
        <p style="font-size: 14px; line-height: 1.5; color: var(--color-text-main); margin-bottom: 16px;">
          For collars, harnesses, and recovery cones, measure your pet's neck and chest circumference using a soft tape measure, leaving two fingers of slack for comfort.
        </p>
        
        <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 20px;">
          <thead>
            <tr style="background: var(--color-bg-subtle); border-bottom: 2px solid var(--color-border); text-align: left;">
              <th style="padding: 10px 12px; font-family: var(--font-heading); font-weight: 700; color: var(--color-primary);">Size</th>
              <th style="padding: 10px 12px; font-family: var(--font-heading); font-weight: 700; color: var(--color-primary);">Neck Circumference</th>
              <th style="padding: 10px 12px; font-family: var(--font-heading); font-weight: 700; color: var(--color-primary);">Chest Circumference</th>
              <th style="padding: 10px 12px; font-family: var(--font-heading); font-weight: 700; color: var(--color-primary);">Typical Breeds / Weight</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 10px 12px; font-weight: 700; color: var(--color-primary);">XS</td>
              <td style="padding: 10px 12px;">4" – 6.5" (10–16 cm)</td>
              <td style="padding: 10px 12px;">8" – 12" (20–30 cm)</td>
              <td style="padding: 10px 12px; color: var(--color-text-muted);">Kittens, Chihuahua (&lt; 6 lbs)</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border); background: var(--color-bg-subtle);">
              <td style="padding: 10px 12px; font-weight: 700; color: var(--color-primary);">S</td>
              <td style="padding: 10px 12px;">6.5" – 9.5" (16–24 cm)</td>
              <td style="padding: 10px 12px;">12" – 16" (30–40 cm)</td>
              <td style="padding: 10px 12px; color: var(--color-text-muted);">Cats, Yorkie, Pomeranian (6–12 lbs)</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 10px 12px; font-weight: 700; color: var(--color-primary);">M</td>
              <td style="padding: 10px 12px;">9.5" – 12.5" (24–32 cm)</td>
              <td style="padding: 10px 12px;">16" – 22" (40–55 cm)</td>
              <td style="padding: 10px 12px; color: var(--color-text-muted);">Pug, French Bulldog, Shih Tzu (12–25 lbs)</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border); background: var(--color-bg-subtle);">
              <td style="padding: 10px 12px; font-weight: 700; color: var(--color-primary);">L</td>
              <td style="padding: 10px 12px;">15.5" – 18.5" (39–47 cm)</td>
              <td style="padding: 10px 12px;">22" – 30" (55–76 cm)</td>
              <td style="padding: 10px 12px; color: var(--color-text-muted);">Border Collie, Spaniel, Corgi (25–50 lbs)</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-border);">
              <td style="padding: 10px 12px; font-weight: 700; color: var(--color-primary);">XL</td>
              <td style="padding: 10px 12px;">18.5" – 22.5" (47–57 cm)</td>
              <td style="padding: 10px 12px;">30" – 38" (76–96 cm)</td>
              <td style="padding: 10px 12px; color: var(--color-text-muted);">Golden Retriever, Lab, German Shepherd (50+ lbs)</td>
            </tr>
          </tbody>
        </table>

        <div style="background: var(--color-bg-muted); border-radius: var(--radius-md); padding: 12px 16px; font-size: 13px; color: var(--color-text-main);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF6B00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block; vertical-align:-2px; margin-right:6px;"><path d="M9 18h6"></path><path d="M10 22h4"></path><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5z"></path></svg><strong>Between sizes?</strong> We recommend sizing up for comfortable fur room, especially for fluffy double-coated breeds.
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  function openSizeGuideModal() {
    var modal = document.getElementById('PetssifySizeGuideModal');
    if (modal) {
      modal.style.display = 'flex';
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }
  function closeSizeGuideModal() {
    var modal = document.getElementById('PetssifySizeGuideModal');
    if (modal) {
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }
</script>
