{%- comment -%}
  Petssify: In-Stock Status Pill (Spec image_c8b0a8.png)
  Pulsing green dot on #E6EFE9 pill surface reading IN STOCK — READY TO SHIP WITHIN 24 HOURS
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<div id="Inventory-{{ section.id }}" class="petssify-inventory-wrapper" role="status">
  <div class="ps-stock-pill" style="margin-bottom: 0;">
    <span class="ps-stock-dot" aria-hidden="true"></span>
    <span>{{ section.settings.stock_badge_text | default: 'IN STOCK — READY TO SHIP WITHIN 24 HOURS' }}</span>
  </div>
</div>
