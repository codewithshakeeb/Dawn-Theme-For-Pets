{%- comment -%}
  Petssify: Real-Time Dynamic In-Stock / Out-of-Stock Status Engine (Spec UI/UX Pro Max)
  - In-stock: Soft emerald surface (#ECFDF5), emerald text (#065F46), border (#A7F3D0), pulsing dot (#10B981), text: "IN STOCK • SHIPS WITHIN 1–2 BUSINESS DAYS"
  - Sold-out: Soft crimson surface (#FEF2F2), crimson text (#991B1B), border (#FECACA), pulsing dot (#DC2626), text: "OUT OF STOCK • THIS VARIANT IS CURRENTLY SOLD OUT"
  - Real-time instant switching on radio change, select change, form input mutation, and URL parameter changes
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign is_in_stock = current_variant.available -%}

<div id="Inventory-{{ section.id }}" class="petssify-inventory-wrapper" role="status" aria-live="polite">
  <div
    class="ps-stock-pill {% if is_in_stock %}is-in-stock{% else %}is-out-of-stock{% endif %}"
    id="ps-stock-pill-{{ section.id }}"
    data-in-stock="{{ is_in_stock }}"
    style="margin-bottom: 0;"
  >
    <span class="ps-stock-dot" aria-hidden="true"></span>
    <span class="ps-stock-text" id="ps-stock-text-{{ section.id }}">
      {%- if is_in_stock -%}
        IN STOCK • SHIPS WITHIN 1–2 BUSINESS DAYS
      {%- else -%}
        OUT OF STOCK • THIS VARIANT IS CURRENTLY SOLD OUT
      {%- endif -%}
    </span>
  </div>

  <!-- Variant Inventory Map for Real-time Switching -->
  <script type="application/json" id="ps-variant-stock-json-{{ section.id }}">
  {
    {%- for variant in product.variants -%}
      "{{ variant.id }}": {{ variant.available | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
  </script>

  <script>
    (function() {
      function initStockStatus() {
        var sectionId = '{{ section.id }}';
        var pill = document.getElementById('ps-stock-pill-' + sectionId);
        var textEl = document.getElementById('ps-stock-text-' + sectionId);
        var jsonEl = document.getElementById('ps-variant-stock-json-' + sectionId);
        if (!pill || !textEl || !jsonEl) return;

        var stockMap = {};
        try {
          stockMap = JSON.parse(jsonEl.textContent);
        } catch(e) {
          console.error('[Petssify Stock] JSON parse error:', e);
          return;
        }

        function updateStockDisplay(variantId) {
          if (!variantId || typeof stockMap[variantId] === 'undefined') return;
          var available = Boolean(stockMap[variantId]);

          if (available) {
            pill.classList.remove('is-out-of-stock');
            pill.classList.add('is-in-stock');
            pill.setAttribute('data-in-stock', 'true');
            textEl.textContent = 'IN STOCK • SHIPS WITHIN 1–2 BUSINESS DAYS';
          } else {
            pill.classList.remove('is-in-stock');
            pill.classList.add('is-out-of-stock');
            pill.setAttribute('data-in-stock', 'false');
            textEl.textContent = 'OUT OF STOCK • THIS VARIANT IS CURRENTLY SOLD OUT';
          }
        }

        // 1. Listen for standard product form input mutations (Dawn variant-radios / variant-selects)
        var productForm = document.querySelector('product-form[data-section-id="' + sectionId + '"]') || document.querySelector('form[action*="/cart/add"]');
        if (productForm) {
          var idInput = productForm.querySelector('input[name="id"]');
          if (idInput) {
            var observer = new MutationObserver(function(mutations) {
              mutations.forEach(function(m) {
                if (m.type === 'attributes' && m.attributeName === 'value') {
                  updateStockDisplay(idInput.value);
                }
              });
            });
            observer.observe(idInput, { attributes: true });

            idInput.addEventListener('change', function() {
              updateStockDisplay(idInput.value);
            });
          }
        }

        // 2. Listen for clicks and changes on variant option inputs
        var variantContainers = document.querySelectorAll('variant-radios, variant-selects, .product-form__input');
        variantContainers.forEach(function(container) {
          container.addEventListener('change', function() {
            setTimeout(function() {
              var idInp = document.querySelector('form[action*="/cart/add"] input[name="id"]');
              if (idInp && idInp.value) {
                updateStockDisplay(idInp.value);
              }
            }, 50);
          });
        });

        // 3. PubSub subscription if available
        if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined' && PUB_SUB_EVENTS.variantChange) {
          subscribe(PUB_SUB_EVENTS.variantChange, function(event) {
            if (event && event.data && event.data.variant) {
              updateStockDisplay(event.data.variant.id);
            }
          });
        }

        // 4. Listen to URL param changes (?variant=...)
        var lastVariantId = new URLSearchParams(window.location.search).get('variant');
        setInterval(function() {
          var currentId = new URLSearchParams(window.location.search).get('variant');
          if (currentId && currentId !== lastVariantId) {
            lastVariantId = currentId;
            updateStockDisplay(currentId);
          }
        }, 300);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initStockStatus);
      } else {
        initStockStatus();
      }
      document.addEventListener('shopify:section:load', initStockStatus);
    })();
  </script>
</div>

<style>
  .ps-stock-pill {
    border-radius: 8px;
    padding: 7px 14px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.025em;
    text-transform: uppercase;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
    font-family: var(--font-body, 'Inter', sans-serif);
  }

  /* In Stock State: Emerald */
  .ps-stock-pill.is-in-stock {
    background: #ECFDF5 !important;
    color: #065F46 !important;
    border: 1px solid #A7F3D0 !important;
  }

  .ps-stock-pill.is-in-stock .ps-stock-dot {
    width: 8.5px;
    height: 8.5px;
    border-radius: 50%;
    background: #10B981 !important;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.28);
    animation: psStockPulseGreen 2s infinite;
    display: inline-block;
    flex-shrink: 0;
  }

  @keyframes psStockPulseGreen {
    0%, 100% {
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.28);
    }
    50% {
      box-shadow: 0 0 0 7px rgba(16, 185, 129, 0);
    }
  }

  /* Out of Stock State: Crimson Red */
  .ps-stock-pill.is-out-of-stock {
    background: #FEF2F2 !important;
    color: #991B1B !important;
    border: 1px solid #FECACA !important;
  }

  .ps-stock-pill.is-out-of-stock .ps-stock-dot {
    width: 8.5px;
    height: 8.5px;
    border-radius: 50%;
    background: #DC2626 !important;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.28);
    animation: psStockPulseRed 2s infinite;
    display: inline-block;
    flex-shrink: 0;
  }

  @keyframes psStockPulseRed {
    0%, 100% {
      box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.28);
    }
    50% {
      box-shadow: 0 0 0 7px rgba(220, 38, 38, 0);
    }
  }
</style>
