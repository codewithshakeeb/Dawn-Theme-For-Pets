{%- comment -%}
  Petssify Product Card (Single Source of Truth Component)
  Matches Base44 Prototype & Reference UI:
  - 12px rounded container with subtle border (#E2E8F0) and smooth hover lift
  - 1:1 square media container, object-fit contain, white background
  - Smooth secondary image reveal on hover (@media (hover: hover))
  - Single top-left badge pill: coral "-XX% OFF" on sale or slate "Sold out"
  - Strict 2-line title clamping with aligned row height
  - Star ratings only rendered when reviews exist (>0 reviews)
  - Price row: bold navy sale price, strikethrough muted compare-at, "From $X" for variant ranges
  - Action button: single-variant AJAX Add to Cart, multi-variant "Choose options", disabled "Sold out"
  - Semantic stretched-link pattern with no nested anchor violations
  - Accessible tap targets (>= 44px) & high-contrast focus rings

  Parameters:
  - product: {Object} Product Liquid object (optional, falls back to card_product)
  - card_product: {Object} Product Liquid object (optional alias)
  - lazy_load: {Boolean} Image loading lazy or eager. Default: true
  - show_quick_add: {Boolean} Show the action button. Default: true
  - show_rating: {Boolean} Show star rating. Default: true
  - image_sizes: {String} Responsive image sizes attribute (optional)
  - section_id: {String} Section ID for unique form IDs (optional)
  - horizontal_class: {Boolean} Horizontal layout modifier for PDP pairs-well-with blocks (optional)
  - placeholder_image: {String} Placeholder image string when product is blank
{%- endcomment -%}

{%- liquid
  assign target_product = product | default: card_product

  if lazy_load == nil
    assign lazy_load = true
  endif

  if show_quick_add == nil
    assign show_quick_add = true
  endif

  if show_rating == nil
    assign show_rating = true
  endif

  if target_product and target_product != empty
    assign current_variant = target_product.selected_or_first_available_variant | default: target_product.variants.first
    assign compare_at_price = current_variant.compare_at_price | default: target_product.compare_at_price_max
    assign price = current_variant.price | default: target_product.price_min
    assign is_available = target_product.available

    assign on_sale = false
    if compare_at_price > price and is_available
      assign discount_pct = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round
      if discount_pct >= 1
        assign on_sale = true
      endif
    endif

    assign product_form_id = 'petssify-quick-add-' | append: section_id | append: '-' | append: target_product.id
    assign featured_media = target_product.featured_media
    assign secondary_media = target_product.media[1] | default: target_product.images[1]
  endif
-%}

{%- if target_product and target_product != empty -%}
  <div
    class="petssify-product-card{% if is_available == false %} petssify-product-card--sold-out{% endif %}{% if horizontal_class %} petssify-product-card--horizontal{% endif %}"
    data-product-id="{{ target_product.id }}"
  >
    <div class="petssify-product-card__media-wrap">
      {%- comment -%} Top-Left Single Status Badge Pill {%- endcomment -%}
      {%- if is_available == false -%}
        <span class="petssify-product-card__badge petssify-product-card__badge--sold-out" aria-label="Sold out">
          Sold out
        </span>
      {%- elsif on_sale -%}
        <span class="petssify-product-card__badge petssify-product-card__badge--sale" aria-label="{{ discount_pct }} percent off">
          -{{ discount_pct }}% OFF
        </span>
      {%- endif -%}

      {%- comment -%} 1:1 Aspect Ratio Media Container {%- endcomment -%}
      <div class="petssify-product-card__media-inner">
        {%- if featured_media != blank -%}
          {%- capture default_sizes -%}
            (min-width: 1200px) 280px, (min-width: 750px) calc((100vw - 60px) / 3), calc((100vw - 36px) / 2)
          {%- endcapture -%}
          {%- assign img_sizes = image_sizes | default: default_sizes -%}

          <img
            srcset="
              {%- if featured_media.width >= 165 -%}{{ featured_media | image_url: width: 165 }} 165w,{%- endif -%}
              {%- if featured_media.width >= 360 -%}{{ featured_media | image_url: width: 360 }} 360w,{%- endif -%}
              {%- if featured_media.width >= 540 -%}{{ featured_media | image_url: width: 540 }} 540w,{%- endif -%}
              {%- if featured_media.width >= 720 -%}{{ featured_media | image_url: width: 720 }} 720w,{%- endif -%}
              {%- if featured_media.width >= 940 -%}{{ featured_media | image_url: width: 940 }} 940w,{%- endif -%}
              {{ featured_media | image_url }} {{ featured_media.width }}w
            "
            src="{{ featured_media | image_url: width: 540 }}"
            sizes="{{ img_sizes }}"
            alt="{{ featured_media.alt | default: target_product.title | escape }}"
            class="petssify-product-card__image petssify-product-card__image--primary"
            {% if lazy_load == false %}
              loading="eager"
              fetchpriority="high"
            {% else %}
              loading="lazy"
              decoding="async"
            {% endif %}
            width="{{ featured_media.width | default: 540 }}"
            height="{{ featured_media.height | default: 540 }}"
          >

          {%- if secondary_media != blank -%}
            <img
              srcset="
                {%- if secondary_media.width >= 165 -%}{{ secondary_media | image_url: width: 165 }} 165w,{%- endif -%}
                {%- if secondary_media.width >= 360 -%}{{ secondary_media | image_url: width: 360 }} 360w,{%- endif -%}
                {%- if secondary_media.width >= 540 -%}{{ secondary_media | image_url: width: 540 }} 540w,{%- endif -%}
                {%- if secondary_media.width >= 720 -%}{{ secondary_media | image_url: width: 720 }} 720w,{%- endif -%}
                {{ secondary_media | image_url }} {{ secondary_media.width }}w
              "
              src="{{ secondary_media | image_url: width: 540 }}"
              sizes="{{ img_sizes }}"
              alt="{{ secondary_media.alt | default: target_product.title | escape }}"
              class="petssify-product-card__image petssify-product-card__image--secondary"
              loading="lazy"
              decoding="async"
              width="{{ secondary_media.width | default: 540 }}"
              height="{{ secondary_media.height | default: 540 }}"
              aria-hidden="true"
            >
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'petssify-product-card__placeholder' }}
        {%- endif -%}
      </div>
    </div>

    <div class="petssify-product-card__content">
      {%- comment -%} 2-Line Clamped Title with Stretched Link {%- endcomment -%}
      <h3 class="petssify-product-card__title">
        <a href="{{ target_product.url }}" class="petssify-product-card__link">
          {{ target_product.title | escape }}
        </a>
      </h3>

      {%- comment -%} Rating Block (renders ONLY if reviews exist) {%- endcomment -%}
      {%- if show_rating -%}
        {%- liquid
          assign rating_value = nil
          assign rating_count = 0

          if target_product.metafields.reviews.rating.value != blank
            assign rating_value = target_product.metafields.reviews.rating.value.rating | round: 1
            assign rating_count = target_product.metafields.reviews.rating_count.value | default: 0
          elsif target_product.metafields.judgeme.badge != blank
            assign jm_badge = target_product.metafields.judgeme.badge
            if jm_badge contains "data-score='"
              assign rating_value = jm_badge | split: "data-score='" | last | split: "'" | first | times: 1.0 | round: 1
            endif
            if jm_badge contains "data-number-of-reviews='"
              assign rating_count = jm_badge | split: "data-number-of-reviews='" | last | split: "'" | first | plus: 0
            endif
          endif
        -%}

        {%- if rating_count > 0 and rating_value != nil -%}
          <div class="petssify-product-card__rating" aria-label="{{ rating_value }} out of 5 stars ({{ rating_count }} reviews)">
            <span class="petssify-product-card__star" aria-hidden="true">★</span>
            <span class="petssify-product-card__rating-value">{{ rating_value }}</span>
            <span class="petssify-product-card__rating-count">({{ rating_count }})</span>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} Price Row {%- endcomment -%}
      <div class="petssify-product-card__price-row">
        {%- if target_product.price_varies -%}
          <span class="petssify-product-card__price-current">
            From {{ target_product.price_min | money }}
          </span>
        {%- else -%}
          <span class="petssify-product-card__price-current">
            {{ price | money }}
          </span>
          {%- if on_sale and compare_at_price > price -%}
            <s class="petssify-product-card__price-compare">
              {{ compare_at_price | money }}
            </s>
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- comment -%} Action Button / Quick Add Row {%- endcomment -%}
      {%- if show_quick_add -%}
        <div class="petssify-product-card__action">
          {%- if is_available == false -%}
            <button
              type="button"
              class="petssify-quick-add__btn button is-sold-out"
              disabled
              aria-disabled="true"
            >
              Sold out
            </button>
          {%- elsif target_product.variants.size > 1 -%}
            <a
              href="{{ target_product.url }}"
              class="petssify-quick-add__btn button button--secondary petssify-quick-add__btn--options"
            >
              Choose options
            </a>
          {%- else -%}
            <product-form data-section-id="{{ section_id }}">
              {%- form 'product',
                target_product,
                id: product_form_id,
                class: 'petssify-product-card__form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ current_variant.id }}"
                  class="product-variant-id"
                >
                <button
                  id="{{ product_form_id }}-submit"
                  type="submit"
                  name="add"
                  class="petssify-quick-add__btn button button--secondary"
                  aria-haspopup="dialog"
                  aria-live="polite"
                >
                  <span class="petssify-quick-add__text">Add to Cart</span>
                  <div class="loading__spinner hidden">
                    {%- render 'loading-spinner' -%}
                  </div>
                </button>
              {%- endform -%}
            </product-form>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- else -%}
  {%- comment -%} Placeholder Card for Empty/Onboarding States {%- endcomment -%}
  <div class="petssify-product-card petssify-product-card--placeholder">
    <div class="petssify-product-card__media-wrap">
      <div class="petssify-product-card__media-inner">
        {%- assign placeholder_name = placeholder_image | default: 'product-1' -%}
        {{ placeholder_name | placeholder_svg_tag: 'petssify-product-card__placeholder' }}
      </div>
    </div>
    <div class="petssify-product-card__content">
      <h3 class="petssify-product-card__title">
        <span class="petssify-product-card__link">Example Product Title</span>
      </h3>
      <div class="petssify-product-card__price-row">
        <span class="petssify-product-card__price-current">$19.99</span>
      </div>
      <div class="petssify-product-card__action">
        <button type="button" class="petssify-quick-add__btn button button--secondary" disabled>
          Add to Cart
        </button>
      </div>
    </div>
  </div>
{%- endif -%}
