{%- comment -%}
  Petssify: "Our Petssify Promise" Card & Payment Security Badges (Spec 2.2 #12)
  Aligned to 100% width of the buy box with 28px centered payment badges.
{%- endcomment -%}

<div class="petssify-buybox-guarantee">
  <div class="petssify-payment-security">
    <div class="petssify-payment-security-header">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>Guaranteed Safe &amp; Secure Checkout</span>
    </div>
    <div class="petssify-payment-badges-row">
      <span class="petssify-payment-badge" title="Visa">
        <svg viewBox="0 0 48 32" height="28" width="42"><rect width="48" height="32" rx="4" fill="#1434CB"></rect><path d="M19.5 21.5h-3.2l2-12.4h3.2l-2 12.4zm11.8-12.1c-.6-.3-1.6-.5-2.8-.5-3.1 0-5.3 1.6-5.3 4 0 1.7 1.6 2.7 2.8 3.3 1.2.6 1.7 1 1.7 1.5 0 .8-1 1.2-1.9 1.2-1.3 0-2-.2-3.1-.7l-.4-.2-.5 2.8c.8.4 2.2.7 3.7.7 3.3 0 5.5-1.6 5.5-4.1 0-1.4-.9-2.4-2.8-3.3-1.2-.6-1.9-1-1.9-1.6 0-.5.6-1.1 1.9-1.1 1.1 0 1.9.2 2.5.5l.3.2.6-2.7zm7.5 7.8l1.6-4.4.9 4.4h-2.5zm3.8 4.3l-2.4-12.4h-2.5c-.8 0-1.4.2-1.7 1l-6 11.4h3.4l.7-1.9h4.1l.4 1.9h3.5zm-16.8-12.4l-3.1 8.5-.3-1.7c-.6-2-2.3-4.1-4.3-5.2l2.8 10.8h3.4l5.1-12.4h-3.6z" fill="#fff"></path></svg>
      </span>
      <span class="petssify-payment-badge" title="Mastercard">
        <svg viewBox="0 0 48 32" height="28" width="42"><rect width="48" height="32" rx="4" fill="#000"></rect><circle cx="18" cy="16" r="10" fill="#EB001B"></circle><circle cx="30" cy="16" r="10" fill="#F79E1B"></circle><path d="M24 8.7a9.96 9.96 0 0 1 0 14.6 9.96 9.96 0 0 1 0-14.6z" fill="#FF5F00"></path></svg>
      </span>
      <span class="petssify-payment-badge" title="American Express">
        <svg viewBox="0 0 48 32" height="28" width="42"><rect width="48" height="32" rx="4" fill="#006FCF"></rect><path d="M9 13.5h3.6l1.2 2.8 1.2-2.8h3.5v9h-2.7v-5.7l-1.3 2.9h-1.6l-1.3-2.9v5.7h-2.6v-9zm11.5 0h6.6l-1.2 2.3h-3.2v1.2h3.2v2h-3.2v1.2h3.4l1 2.3h-6.6v-9zm8.5 0h2.9l1.8 3.5 1.8-3.5h2.9l-3.2 5.5 3.4 3.5h-3.2l-1.8-2.2-1.8 2.2h-2.9l3.3-3.6-3.2-5.4z" fill="#fff"></path></svg>
      </span>
      <span class="petssify-payment-badge" title="PayPal">
        <svg viewBox="0 0 48 32" height="28" width="42"><rect width="48" height="32" rx="4" fill="#003087"></rect><path d="M19.4 8.5h5.8c3.2 0 4.8 1.5 4.3 4.5-.4 2.8-2.2 4.4-4.8 4.4h-2.4l-.9 5.8h-3l2.8-14.7z" fill="#0079C1"></path><path d="M22.5 13.2h3.6c2.4 0 3.7 1.1 3.3 3.5-.4 2.4-1.9 3.7-4.1 3.7h-2.1l-.9 5.4h-2.7l2.9-12.6z" fill="#00457C"></path></svg>
      </span>
      <span class="petssify-payment-badge" title="Apple Pay">
        <svg viewBox="0 0 48 32" height="28" width="42"><rect width="48" height="32" rx="4" fill="#000"></rect><path d="M16.5 15.6c0-1.6 1.3-2.5 1.4-2.6-.8-1.1-2-1.2-2.4-1.2-1-.1-2 .6-2.5.6-.5 0-1.4-.6-2.2-.6-1.1 0-2.2.7-2.8 1.7-1.2 2-0.3 5 0.8 6.7.6.8 1.2 1.7 2.1 1.7.9 0 1.2-.5 2.2-.5 1.1 0 1.3.5 2.2.5.9 0 1.5-.8 2-1.6.7-1 1-2 1-2.1-.1 0-1.8-.7-1.8-2.6zm-1.6-4.5c.5-.6.8-1.4.7-2.2-.7 0-1.6.5-2.1 1.1-.4.5-.8 1.3-.7 2.1.8.1 1.6-.4 2.1-1z" fill="#fff"></path><path d="M22.8 10h2.3v13.5h-2.3V10zm5.7 3.5h2.2v1.4c.6-1 1.7-1.6 2.8-1.6 1.9 0 3.5 1.6 3.5 3.8s-1.6 3.8-3.5 3.8c-1.1 0-2.2-.6-2.7-1.5v4.2h-2.3V13.5zm4.8 5.6c1.1 0 1.9-.9 1.9-2s-.8-2-1.9-2-1.9.9-1.9 2 .8 2 1.9 2z" fill="#fff"></path></svg>
      </span>
      <span class="petssify-payment-badge" title="Google Pay">
        <svg viewBox="0 0 48 32" height="28" width="42"><rect width="48" height="32" rx="4" fill="#fff" stroke="#e5e7eb"></rect><path d="M18.8 16.2v4.5h-1.5V9.4h3.9c1 0 1.9.3 2.6 1 .7.7 1.1 1.5 1.1 2.5s-.4 1.8-1.1 2.5c-.7.7-1.6 1-2.6 1h-2.4v-.2zm0-5.4v3.9h2.5c.6 0 1.1-.2 1.5-.6.4-.4.6-.9.6-1.4s-.2-1-.6-1.4c-.4-.4-.9-.6-1.5-.6h-2.5v.1zm8.2 4.1c.9 0 1.6.2 2.2.7.6.5.9 1.2.9 2v4.1h-1.4v-1c-.6.8-1.4 1.2-2.3 1.2-.8 0-1.4-.2-1.9-.7-.5-.5-.8-1.1-.8-1.8s.3-1.3.8-1.7c.6-.4 1.3-.6 2.2-.6.8 0 1.5.1 2 .4v-.3c0-.5-.2-.9-.6-1.2-.4-.3-.9-.5-1.4-.5-.8 0-1.4.3-1.8 1l-1.3-.8c.7-1 1.8-1.5 3.1-1.5z" fill="#5F6368"></path><path d="M12.7 16.2c0-.3 0-.6-.1-.9h-4.3v1.8h2.5c-.1.6-.4 1.1-.9 1.4v1.2h1.5c.8-.8 1.3-2 1.3-3.5z" fill="#4285F4"></path><path d="M8.3 20.7c1.2 0 2.2-.4 3-1.1l-1.5-1.2c-.4.3-.9.5-1.5.5-1.1 0-2.1-.8-2.5-1.8H4.3v1.2c.7 1.5 2.2 2.4 4 2.4z" fill="#34A853"></path><path d="M5.8 17.1c-.2-.6-.2-1.2 0-1.8v-1.2H4.3c-.6 1.2-.6 2.7 0 4l1.5-1z" fill="#FBBC04"></path><path d="M8.3 13.5c.6 0 1.2.2 1.7.7l1.3-1.3c-.8-.8-1.9-1.2-3-1.2-1.8 0-3.3.9-4 2.4l1.5 1.2c.4-1 1.4-1.8 2.5-1.8z" fill="#EA4335"></path></svg>
      </span>
    </div>
  </div>

  <div class="petssify-promise-card">
    <div class="petssify-promise-card__header">
      <svg class="petssify-promise-card__shield" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      <span class="petssify-promise-card__title">OUR PETSSIFY PROMISE</span>
    </div>

    <ul class="petssify-promise-card__list" role="list">
      <li class="petssify-promise-card__item">
        <span class="petssify-promise-card__icon" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span class="petssify-promise-card__text"><strong>Free Shipping</strong> on orders over $50</span>
      </li>
      <li class="petssify-promise-card__item">
        <span class="petssify-promise-card__icon" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span class="petssify-promise-card__text"><strong>30-Day Money-Back Guarantee</strong> — Hassle-Free Returns</span>
      </li>
      <li class="petssify-promise-card__item">
        <span class="petssify-promise-card__icon" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        <span class="petssify-promise-card__text"><strong>Email Support</strong> within 24 hours Mon–Fri</span>
      </li>
    </ul>
  </div>
</div>
