<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="page-width">
    <ol class="breadcrumbs__list">

      <!-- HOME -->
      <li class="breadcrumbs__item">
        <a href="{{ routes.root_url }}">Home</a>
      </li>

      {% case request.page_type %}

        <!-- ========================= -->
        <!-- PRODUCT PAGE -->
        <!-- ========================= -->
        {% when 'product' %}

          {%- comment -%} Petssify: Intelligent collection context & cross-species guard (Spec 3.5) {%- endcomment -%}
          {% assign breadcrumb_collection = collection %}
          {% unless breadcrumb_collection %}
            {% for product_collection in product.collections %}
              {% assign collection_handle = product_collection.handle | downcase %}
              {% unless collection_handle == 'all'
                or collection_handle contains 'best-seller'
                or collection_handle contains 'best_seller'
                or collection_handle contains 'sale'
                or collection_handle contains 'accessories'
                or collection_handle contains 'featured'
                or collection_handle contains 'all-products'
              %}
                {% if product.title contains 'Dog' and collection_handle contains 'cat' %}
                  {% continue %}
                {% endif %}
                {% if product.title contains 'Cat' and collection_handle contains 'dog' %}
                  {% continue %}
                {% endif %}
                {% assign breadcrumb_collection = product_collection %}
                {% break %}
              {% endunless %}
            {% endfor %}
          {% endunless %}


          {% if breadcrumb_collection != blank %}

            <li class="breadcrumbs__separator" aria-hidden="true">
              ›
            </li>

            <li class="breadcrumbs__item">
              <a href="{{ breadcrumb_collection.url }}">
                {{ breadcrumb_collection.title }}
              </a>
            </li>

          {% endif %}


          <!-- CURRENT PRODUCT -->

          <li class="breadcrumbs__separator" aria-hidden="true">
            ›
          </li>

          <li class="breadcrumbs__item breadcrumbs__item--current">
            <span aria-current="page">
              {{ product.title }}
            </span>
          </li>


        <!-- ========================= -->
        <!-- COLLECTION PAGE -->
        <!-- ========================= -->
        {% when 'collection' %}

          <li class="breadcrumbs__separator" aria-hidden="true">
            ›
          </li>

          <li class="breadcrumbs__item breadcrumbs__item--current">
            <span aria-current="page">
              {{ collection.title }}
            </span>
          </li>


        <!-- ========================= -->
        <!-- PAGE -->
        <!-- ========================= -->
        {% when 'page' %}

          <li class="breadcrumbs__separator" aria-hidden="true">
            ›
          </li>

          <li class="breadcrumbs__item breadcrumbs__item--current">
            <span aria-current="page">
              {{ page.title }}
            </span>
          </li>


        <!-- ========================= -->
        <!-- BLOG -->
        <!-- ========================= -->
        {% when 'blog' %}

          <li class="breadcrumbs__separator" aria-hidden="true">
            ›
          </li>

          <li class="breadcrumbs__item breadcrumbs__item--current">
            <span aria-current="page">
              {{ blog.title }}
            </span>
          </li>


        <!-- ========================= -->
        <!-- ARTICLE -->
        <!-- ========================= -->
        {% when 'article' %}

          <li class="breadcrumbs__separator" aria-hidden="true">
            ›
          </li>

          <li class="breadcrumbs__item">
            <a href="{{ blog.url }}">
              {{ blog.title }}
            </a>
          </li>

          <li class="breadcrumbs__separator" aria-hidden="true">
            ›
          </li>

          <li class="breadcrumbs__item breadcrumbs__item--current">
            <span aria-current="page">
              {{ article.title }}
            </span>
          </li>

      {% endcase %}

    </ol>
  </div>
</nav>