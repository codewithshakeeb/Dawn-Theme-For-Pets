{% comment %}
  Snippet: snippets/petssify-bfcm-offer-box.liquid
  Petssify Black Friday PDP Conversion Stack (UI/UX Pro Max Bespoke Edition):
  - Dynamic Price + Compare-At Price + SAVE X% OFF Pill Badge (when show_price: true)
  - Pulsing IN STOCK • SHIPS WITHIN 1–2 BUSINESS DAYS Badge (when show_price: true)
  - Black Friday Special Offer Card with Crisp Inline Vector SVGs (no emoji spam)
  - 48-Hour Rolling Countdown Timer in Tabular Numerals (#C2410C)
  - #F8FAFC Card Surface with 1px solid #E2E8F0 and 3px solid #090D16 top accent border
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign has_discount = false -%}
{%- if current_variant.compare_at_price > current_variant.price -%}
  {%- assign has_discount = true -%}
  {%- assign discount_amount = current_variant.compare_at_price | minus: current_variant.price -%}
  {%- assign discount_pct = discount_amount | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
{%- endif -%}

<div class="ps-pdp-conversion-stack" id="ps-bfcm-stack-{{ section.id }}">
  {%- if show_price == true -%}
    <!-- 1. Dynamic Price + Compare-At + SAVE X% OFF Pill -->
    <div class="ps-price-row" data-ps-price-row>
      <span class="ps-price-current" data-ps-current-price>
        {{ current_variant.price | money }}
      </span>
      <span
        class="ps-price-compare{% unless has_discount %} ps-hidden{% endunless %}"
        data-ps-compare-price
      >
        {%- if has_discount -%}
          {{ current_variant.compare_at_price | money }}
        {%- endif -%}
      </span>
      <span
        class="ps-save-pill{% unless has_discount %} ps-hidden{% endunless %}"
        data-ps-save-pill
      >
        SAVE <span data-ps-discount-pct>{{ discount_pct }}</span>% OFF
      </span>
    </div>

    <!-- 2. Pulsing Stock Status Pill -->
    <div class="ps-stock-pill" data-ps-stock-pill>
      <span class="ps-stock-dot" aria-hidden="true"></span>
      <span data-ps-stock-text>{{ section.settings.stock_badge_text | default: 'IN STOCK • SHIPS WITHIN 1–2 BUSINESS DAYS' }}</span>
    </div>
  {%- endif -%}

  {%- assign bfcm_title = block.settings.bfcm_title | default: section.settings.bfcm_title | default: 'Black Friday Special Offer' -%}
  {%- assign bfcm_badge = block.settings.bfcm_badge_text | default: section.settings.bfcm_badge_text | default: 'SAVE 20%' -%}
  {%- assign bfcm_timer_label = block.settings.bfcm_timer_label | default: section.settings.bfcm_timer_label | default: 'Deal ends in:' -%}
  {%- assign bfcm_end_date = block.settings.bfcm_end_date | default: section.settings.bfcm_end_date | default: '2026-11-30T23:59:59' -%}
  {%- assign bfcm_urgency = block.settings.bfcm_urgency_text | default: section.settings.bfcm_urgency_text | default: 'High Demand: Limited Black Friday allocation remaining' -%}
  {%- assign bfcm_subtext = block.settings.bfcm_subtext | default: section.settings.bfcm_subtext | default: 'Extra 20% applied at checkout • 30-Day Money-Back Guarantee' -%}

  <!-- 3. Black Friday Special Offer Card -->
  {%- if section.settings.enable_bfcm_box != false -%}
    <div
      class="ps-bfcm-card"
      data-bfcm-timer
      data-end-date="{{ bfcm_end_date }}"
    >
      <!-- Header Row: Title with Vector Tag Icon + SAVE 20% Pill -->
      <div class="ps-bfcm-header">
        <div class="ps-bfcm-title-wrap">
          <svg class="ps-bfcm-tag-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FF6B00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
            <line x1="7" y1="7" x2="7.01" y2="7"></line>
          </svg>
          <span class="ps-bfcm-title">{{ bfcm_title }}</span>
        </div>
        <span class="ps-bfcm-badge">{{ bfcm_badge }}</span>
      </div>

      <!-- Countdown Box (Inner White Pill Box) -->
      <div class="ps-bfcm-timer-box">
        <div class="ps-bfcm-timer-label">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#090D16" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>{{ bfcm_timer_label }}</span>
        </div>
        <div class="ps-bfcm-countdown" data-bfcm-clock>
          <span class="ps-bfcm-pill"><span class="ps-bfcm-num" data-bfcm-d>01</span><span class="ps-bfcm-lbl">d</span></span>
          <span class="ps-bfcm-pill"><span class="ps-bfcm-num" data-bfcm-h>18</span><span class="ps-bfcm-lbl">h</span></span>
          <span class="ps-bfcm-pill"><span class="ps-bfcm-num" data-bfcm-m>45</span><span class="ps-bfcm-lbl">m</span></span>
          <span class="ps-bfcm-pill"><span class="ps-bfcm-num" data-bfcm-s>12</span><span class="ps-bfcm-lbl">s</span></span>
        </div>
      </div>

      <!-- Urgency Row with Vector Icon -->
      <div class="ps-bfcm-urgency">
        <svg class="ps-bolt-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#FF6B00" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span class="ps-urgency-body">{{ bfcm_urgency }}</span>
      </div>

      <!-- Trust Sub-Line with Vector Check -->
      <div class="ps-bfcm-subtext">
        <svg class="ps-check-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>{{ bfcm_subtext }}</span>
      </div>
    </div>
  {%- endif -%}
</div>

<style>
  .ps-pdp-conversion-stack {
    margin: 14px 0 16px;
    font-family: inherit;
  }

  .ps-hidden {
    display: none !important;
  }

  /* 1. Price Row */
  .ps-price-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
    font-variant-numeric: tabular-nums;
  }

  .ps-price-current {
    font-size: 30px;
    font-weight: 800;
    color: #090D16;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  .ps-price-compare {
    font-size: 20px;
    font-weight: 500;
    color: #64748B;
    text-decoration: line-through;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-body, 'Inter', sans-serif);
  }

  .ps-save-pill {
    background-color: #090D16;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 999px;
    letter-spacing: 0.03em;
    display: inline-flex;
    align-items: center;
    box-shadow: 0 2px 6px rgba(9, 13, 22, 0.12);
    font-variant-numeric: tabular-nums;
    font-family: var(--font-body, 'Inter', sans-serif);
  }

  /* 2. Pulsing Stock Status Pill */
  .ps-stock-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #ECFDF5;
    color: #065F46;
    border: 1px solid #A7F3D0;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    margin-bottom: 14px;
    font-family: var(--font-body, 'Inter', sans-serif);
  }

  .ps-stock-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10B981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.28);
    display: inline-block;
    flex-shrink: 0;
    animation: psStockPulseGreen 2s infinite;
  }

  /* 3. Black Friday Special Offer Card */
  .ps-bfcm-card {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-top: 3px solid #090D16;
    border-radius: 14px;
    padding: 16px 18px 14px;
    box-shadow: 0 4px 18px -2px rgba(9, 13, 22, 0.06);
    box-sizing: border-box;
  }

  .ps-bfcm-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .ps-bfcm-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ps-bfcm-tag-icon {
    flex-shrink: 0;
  }

  .ps-bfcm-title {
    font-size: 16px;
    font-weight: 800;
    color: #090D16;
    letter-spacing: -0.01em;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  .ps-bfcm-badge {
    background-color: #FF6B00;
    color: #FFFFFF;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
    box-shadow: 0 2px 8px rgba(255, 107, 0, 0.32);
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  /* Countdown Inner Box */
  .ps-bfcm-timer-box {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .ps-bfcm-timer-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 700;
    color: #090D16;
    font-family: var(--font-body, 'Inter', sans-serif);
  }

  .ps-bfcm-countdown {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14.5px;
    font-weight: 800;
    color: #C2410C;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-heading, 'Plus Jakarta Sans', sans-serif);
  }

  .ps-bfcm-pill {
    display: inline-flex;
    align-items: baseline;
    background: #FFF7ED;
    border: 1px solid #FFEDD5;
    color: #EA580C;
    padding: 3px 6px;
    border-radius: 6px;
    font-weight: 800;
    font-size: 13.5px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 1px 2px rgba(234, 88, 12, 0.05);
  }

  .ps-bfcm-pill .ps-bfcm-lbl {
    font-size: 10.5px;
    font-weight: 700;
    color: #C2410C;
    margin-left: 2px;
    text-transform: lowercase;
  }

  /* Urgency Row */
  .ps-bfcm-urgency {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: #334155;
    margin-bottom: 6px;
    line-height: 1.4;
    font-family: var(--font-body, 'Inter', sans-serif);
  }

  .ps-bolt-svg {
    flex-shrink: 0;
  }

  .ps-urgency-body strong {
    color: #090D16;
    font-weight: 700;
  }

  /* Trust Subtext */
  .ps-bfcm-subtext {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: #64748B;
    line-height: 1.4;
    font-family: var(--font-body, 'Inter', sans-serif);
  }

  .ps-check-svg {
    flex-shrink: 0;
  }

  @media screen and (max-width: 480px) {
    .ps-price-current {
      font-size: 26px;
    }
    .ps-price-compare {
      font-size: 17px;
    }
    .ps-bfcm-card {
      padding: 14px 14px 12px;
    }
    .ps-bfcm-timer-box {
      padding: 9px 10px;
      gap: 6px;
    }
    .ps-bfcm-timer-label {
      font-size: 12.5px;
      gap: 6px;
    }
    .ps-bfcm-countdown {
      font-size: 13px;
      gap: 3px;
    }
    .ps-bfcm-pill {
      padding: 2.5px 5px;
      font-size: 12px;
      border-radius: 5px;
    }
    .ps-bfcm-pill .ps-bfcm-lbl {
      font-size: 9.5px;
    }
  }
</style>

<script>
  (function() {
    function parseTarget(str) {
      if (!str || typeof str !== 'string') return NaN;
      var cleaned = str.trim();

      // Check for rolling duration syntax like "48h", "24h", "2d"
      var hourMatch = cleaned.match(/^(\d+)\s*h(?:ours?)?$/i);
      if (hourMatch) {
        return Date.now() + parseInt(hourMatch[1], 10) * 3600000;
      }
      var dayMatch = cleaned.match(/^(\d+)\s*d(?:ays?)?$/i);
      if (dayMatch) {
        return Date.now() + parseInt(dayMatch[1], 10) * 86400000;
      }

      // Convert format YYYY-MM-DD HH:mm:ss to ISO YYYY-MM-DDTHH:mm:ss
      if (/^\d{4}-\d{2}-\d{2}\s\d{2}:\d{2}(:\d{2})?$/.test(cleaned)) {
        cleaned = cleaned.replace(' ', 'T');
      }
      if (/^\d{4}-\d{2}-\d{2}$/.test(cleaned)) {
        cleaned += 'T23:59:59';
      }
      var t = new Date(cleaned).getTime();
      if (!isNaN(t)) return t;
      t = Date.parse(cleaned);
      return isNaN(t) ? NaN : t;
    }

    function initBfcmStack() {
      // Purge legacy localStorage keys that locked timer into 18h
      try {
        localStorage.removeItem('petssify_bfcm_urgency_timer_v3');
        localStorage.removeItem('petssify_bfcm_urgency_timer_v2');
        localStorage.removeItem('petssify_bfcm_urgency_timer_v1');
      } catch (e) {}

      var cards = document.querySelectorAll('.ps-pdp-conversion-stack [data-bfcm-timer]');
      if (!cards || cards.length === 0) return;

      var now = Date.now();
      var masterGlobalKey = 'petssify_promo_timer_master_v2';
      var masterTime = localStorage.getItem(masterGlobalKey);
      var masterTimestamp = masterTime ? parseInt(masterTime, 10) : NaN;

      cards.forEach(function(card) {
        if (card._bfcmInterval) {
          clearInterval(card._bfcmInterval);
          card._bfcmInterval = null;
        }

        var clockEl = card.querySelector('[data-bfcm-clock]');
        if (!clockEl) return;

        var endDateStr = card.getAttribute('data-end-date');
        var targetTime = parseTarget(endDateStr);

        // If targetTime is invalid or in the past:
        if (isNaN(targetTime) || targetTime <= now) {
          // Check if master promo timer from banner exists
          if (!isNaN(masterTimestamp) && masterTimestamp > now) {
            targetTime = masterTimestamp;
          } else {
            // Default Black Friday End Date: Nov 30, 2026 23:59:59
            var defaultDate = parseTarget('2026-11-30T23:59:59');
            if (!isNaN(defaultDate) && defaultDate > now) {
              targetTime = defaultDate;
            } else {
              targetTime = now + (2 * 86400000) + (5 * 3600000) + (54 * 60000);
            }
          }
        }

        var dEl = clockEl.querySelector('[data-bfcm-d]');
        var hEl = clockEl.querySelector('[data-bfcm-h]');
        var mEl = clockEl.querySelector('[data-bfcm-m]');
        var sEl = clockEl.querySelector('[data-bfcm-s]');

        function updateClock() {
          var currentNow = Date.now();
          var diff = targetTime - currentNow;
          if (diff <= 0) {
            diff = 0;
          }
          var d = Math.floor(diff / 86400000);
          var h = Math.floor((diff % 86400000) / 3600000);
          var m = Math.floor((diff % 3600000) / 60000);
          var s = Math.floor((diff % 60000) / 1000);

          var dStr = d < 10 ? '0' + d : String(d);
          var hStr = h < 10 ? '0' + h : String(h);
          var mStr = m < 10 ? '0' + m : String(m);
          var sStr = s < 10 ? '0' + s : String(s);

          if (dEl && hEl && mEl && sEl) {
            dEl.textContent = dStr;
            hEl.textContent = hStr;
            mEl.textContent = mStr;
            sEl.textContent = sStr;
          } else {
            clockEl.textContent = dStr + 'd ' + hStr + 'h ' + mStr + 'm ' + sStr + 's';
          }
        }

        updateClock();
        card._bfcmInterval = setInterval(updateClock, 1000);
      });

      // Sync Variant Price, Compare At, and SAVE % Pill
      function formatMoney(cents) {
        if (typeof window.Shopify !== 'undefined' && window.Shopify.formatMoney) {
          return window.Shopify.formatMoney(cents, '{{ shop.money_format | default: "$%7B%7Bamount%7D%7D" }}');
        }
        return '$' + (cents / 100).toFixed(2);
      }

      function handleVariantChange(variant) {
        if (!variant) return;

        var stack = document.getElementById('ps-bfcm-stack-{{ section.id }}');
        if (!stack) return;

        var curPriceEl = stack.querySelector('[data-ps-current-price]');
        var compPriceEl = stack.querySelector('[data-ps-compare-price]');
        var savePillEl = stack.querySelector('[data-ps-save-pill]');
        var discPctEl = stack.querySelector('[data-ps-discount-pct]');

        if (curPriceEl) {
          curPriceEl.textContent = formatMoney(variant.price);
        }

        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          var diff = variant.compare_at_price - variant.price;
          var pct = Math.round((diff * 100) / variant.compare_at_price);
          if (compPriceEl) {
            compPriceEl.textContent = formatMoney(variant.compare_at_price);
            compPriceEl.classList.remove('ps-hidden');
          }
          if (savePillEl) {
            if (discPctEl) discPctEl.textContent = pct;
            savePillEl.classList.remove('ps-hidden');
          }
        } else {
          if (compPriceEl) compPriceEl.classList.add('ps-hidden');
          if (savePillEl) savePillEl.classList.add('ps-hidden');
        }
      }

      if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined' && PUB_SUB_EVENTS.variantChange) {
        subscribe(PUB_SUB_EVENTS.variantChange, function(event) {
          if (event && event.data && event.data.variant) {
            handleVariantChange(event.data.variant);
          }
        });
      }

      document.addEventListener('change', function(e) {
        if (e.target && (e.target.matches('[name="id"]') || e.target.closest('[data-section="{{ section.id }}"]'))) {
          var form = document.querySelector('#product-form-{{ section.id }}');
          if (form) {
            var varInput = form.querySelector('input[name="id"]');
            if (varInput && varInput.value && window._petssifyProductVariants) {
              var found = window._petssifyProductVariants.find(function(v) { return String(v.id) === String(varInput.value); });
              if (found) handleVariantChange(found);
            }
          }
        }
      });
    }

    window._petssifyProductVariants = {{ product.variants | json }};

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBfcmStack);
    } else {
      initBfcmStack();
    }

    document.addEventListener('shopify:section:load', initBfcmStack);
    document.addEventListener('shopify:section:select', initBfcmStack);
    document.addEventListener('shopify:section:reorder', initBfcmStack);
  })();
</script>
