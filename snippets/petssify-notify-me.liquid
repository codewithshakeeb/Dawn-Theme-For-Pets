{%- comment -%}
  Petssify: Out-of-Stock "Notify Me When Available" Form
  Uses Shopify's native Customer/Contact form API with product & variant tags.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<div id="PetssifyNotifyMe-{{ section.id }}" class="petssify-notify-me-block{% if current_variant.available %} petssify-hidden{% endif %}" data-product-handle="{{ product.handle }}">
  <div class="petssify-notify-me__header">
    <svg class="petssify-notify-me__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
      <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
    </svg>
    <span class="petssify-notify-me__title">Notify me when it's back</span>
  </div>
  <p class="petssify-notify-me__subtitle">
    Join the waitlist and we'll email you as soon as it's available.
  </p>

  {%- form 'contact', id: 'petssify-notify-me-form', class: 'petssify-notify-me__form' -%}
    {%- if form.posted_successfully? -%}
      <div class="petssify-notify-me__alert petssify-notify-me__alert--success" role="status">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>You're on the list! We'll notify you as soon as this item is back in stock.</span>
      </div>
    {%- else -%}
      {%- if form.errors -%}
        <div class="petssify-notify-me__alert petssify-notify-me__alert--error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <input type="hidden" name="contact[tags]" value="back-in-stock-notification, {{ product.title | escape }} - {{ current_variant.title | escape }}">
      <input type="hidden" name="contact[Product Title]" value="{{ product.title | escape }}">
      <input type="hidden" name="contact[Variant]" value="{{ current_variant.title | escape }} (ID: {{ current_variant.id }})">
      <input type="hidden" name="contact[Product URL]" value="{{ shop.url }}{{ product.url }}?variant={{ current_variant.id }}">

      <div class="petssify-notify-me__input-row">
        <input
          type="email"
          name="contact[email]"
          id="PetssifyNotifyEmail-{{ section.id }}"
          class="petssify-notify-me__input"
          placeholder="Enter your email address"
          value="{% if customer %}{{ customer.email }}{% endif %}"
          required
          aria-label="Email address for back-in-stock alert"
          autocomplete="email"
        >
        <button type="submit" class="button button--secondary petssify-notify-me__button">
          Notify me
        </button>
      </div>
    {%- endif -%}
  {%- endform -%}
</div>
