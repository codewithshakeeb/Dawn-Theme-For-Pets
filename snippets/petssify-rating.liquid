{%- comment -%}
  Petssify 5-Star Rating Component (UI/UX Pro Max Edition)
  - 14px Crisp 5-point star SVGs with balanced spacing
  - Vibrant Golden Amber color (#FFA41C) with #E2E8F0 empty track
  - Clean tabular score and review count typography
{%- endcomment -%}

{%- liquid
  assign target_product = product | default: card_product

  assign val = rating_value
  assign cnt = rating_count

  if val == nil and target_product != blank
    if target_product.metafields.reviews.rating.value != blank
      assign val = target_product.metafields.reviews.rating.value.rating | times: 1.0
      assign cnt = target_product.metafields.reviews.rating_count.value | default: target_product.metafields.reviews.rating_count | plus: 0
    elsif target_product.metafields.reviews.rating != blank
      assign val = target_product.metafields.reviews.rating | times: 1.0
      assign cnt = target_product.metafields.reviews.rating_count | plus: 0
    elsif target_product.metafields.judgeme.badge != blank
      assign jm_badge = target_product.metafields.judgeme.badge
      if jm_badge contains "data-score='"
        assign val = jm_badge | split: "data-score='" | last | split: "'" | first | times: 1.0
      elsif jm_badge contains "data-average-rating='"
        assign val = jm_badge | split: "data-average-rating='" | last | split: "'" | first | times: 1.0
      endif
      if jm_badge contains "data-number-of-reviews='"
        assign cnt = jm_badge | split: "data-number-of-reviews='" | last | split: "'" | first | plus: 0
      endif
    elsif target_product.metafields.custom.rating != blank
      assign val = target_product.metafields.custom.rating.value | default: target_product.metafields.custom.rating | times: 1.0
      assign cnt = target_product.metafields.custom.review_count.value | default: target_product.metafields.custom.review_count | default: target_product.metafields.custom.reviews_count | default: 1 | plus: 0
    endif
  endif
-%}

{%- if val != nil and cnt > 0 and val > 0 -%}
  {%- liquid
    assign score = val | at_most: 5.0 | at_least: 0.0
    assign fill_percent = score | times: 100.0 | divided_by: 5.0 | round: 1
    assign score_rounded = score | round: 1
    assign score_str = score_rounded | append: ''
    unless score_str contains '.'
      assign score_str = score_str | append: '.0'
    endunless

    assign color_star = star_color
    if color_star == blank
      assign color_star = settings.star_rating_color | default: '#FFA41C'
    endif

    if cnt == 1
      assign review_word = 'review'
    else
      assign review_word = 'reviews'
    endif
  -%}

  <div
    class="petssify-rating{% if class != blank %} {{ class }}{% endif %}"
    role="img"
    aria-label="Rated {{ score_str }} out of 5 stars based on {{ cnt }} {{ review_word }}"
    style="--petssify-star-color: {{ color_star }};"
  >
    <div class="petssify-rating__stars" aria-hidden="true">
      <div class="petssify-rating__stars-bg">
        {%- for i in (1..5) -%}
          <svg class="petssify-rating__star-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
          </svg>
        {%- endfor -%}
      </div>
      <div class="petssify-rating__stars-fill" style="width: {{ fill_percent }}%;">
        <div class="petssify-rating__stars-fill-inner">
          {%- for i in (1..5) -%}
            <svg class="petssify-rating__star-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
            </svg>
          {%- endfor -%}
        </div>
      </div>
    </div>
    <span class="petssify-rating__value" aria-hidden="true">{{ score_str }}</span>
    <span class="petssify-rating__count" aria-hidden="true">({{ cnt }})</span>
  </div>

  <style>
    .petssify-rating {
      display: inline-flex !important;
      align-items: center !important;
      vertical-align: middle !important;
      gap: 5px !important;
      margin: 4px 0 6px 0 !important;
      line-height: 1 !important;
      position: relative !important;
      z-index: 2 !important;
    }
    .petssify-rating__stars {
      position: relative !important;
      display: inline-flex !important;
      width: 82px !important;
      height: 14px !important;
      flex-shrink: 0 !important;
      line-height: 1 !important;
    }
    .petssify-rating__stars-bg {
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      width: 82px !important;
      height: 14px !important;
      color: #E2E8F0 !important;
    }
    .petssify-rating__stars-fill {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      bottom: 0 !important;
      overflow: hidden !important;
      height: 14px !important;
    }
    .petssify-rating__stars-fill-inner {
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      width: 82px !important;
      height: 14px !important;
      color: var(--petssify-star-color, #FFA41C) !important;
    }
    .petssify-rating__star-icon {
      width: 14px !important;
      height: 14px !important;
      flex-shrink: 0 !important;
      display: block !important;
    }
    .petssify-rating__value {
      font-family: var(--font-body-family, 'Inter', -apple-system, BlinkMacSystemFont, sans-serif) !important;
      font-size: 13.5px !important;
      font-weight: 700 !important;
      color: #0F172A !important;
      letter-spacing: -0.01em !important;
      margin-left: 2px !important;
      line-height: 1 !important;
      font-variant-numeric: tabular-nums !important;
    }
    .petssify-rating__count {
      font-family: var(--font-body-family, 'Inter', -apple-system, BlinkMacSystemFont, sans-serif) !important;
      font-size: 13px !important;
      font-weight: 500 !important;
      color: #64748B !important;
      letter-spacing: 0 !important;
      margin-left: 1px !important;
      line-height: 1 !important;
      font-variant-numeric: tabular-nums !important;
    }
  </style>
{%- endif -%}
