{%- comment -%}
  Petssify: Free Shipping Progress Bar (Spec 1.3)
  Default threshold: $50.00 (5000 cents)
{%- endcomment -%}
{%- assign free_shipping_threshold = settings.free_shipping_threshold | default: 5000 -%}
{%- assign cart_total = cart.total_price -%}
{%- assign progress_percent = cart_total | times: 100.0 | divided_by: free_shipping_threshold | at_most: 100 -%}

<div class="petssify-shipping-bar{% if cart_total >= free_shipping_threshold %} is-unlocked{% endif %}" data-threshold="{{ free_shipping_threshold }}">
  <div class="petssify-shipping-bar__message">
    {%- if cart_total >= free_shipping_threshold -%}
      <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:-2px; margin-right:6px;" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>You've unlocked <strong>FREE Tracked US Shipping!</strong></span>
    {%- else -%}
      {%- assign remaining_cents = free_shipping_threshold | minus: cart_total -%}
      {%- assign remaining_money = remaining_cents | money -%}
      <span>Add <strong>{{ remaining_money }}</strong> more to unlock <strong>FREE Tracked US Shipping!</strong></span>
    {%- endif -%}
  </div>
  <div class="petssify-shipping-bar__progress-track" role="progressbar" aria-valuenow="{{ progress_percent | round }}" aria-valuemin="0" aria-valuemax="100">
    <div
      class="petssify-shipping-bar__progress-fill"
      style="width: {{ progress_percent }}%; background: {% if cart_total >= free_shipping_threshold %}linear-gradient(90deg, #10B981 0%, #059669 100%){% else %}linear-gradient(90deg, #FF7A29 0%, #F59E0B 35%, #10B981 80%, #059669 100%){% endif %};"
    ></div>
  </div>
</div>
