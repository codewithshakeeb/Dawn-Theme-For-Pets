{%- comment -%}
  Petssify: 3-Column Trust Row (Spec 2.2 #10)
  High-conversion trust badges with line icons and dual-line copy.
{%- endcomment -%}

<div class="petssify-trust-row" role="region" aria-label="Trust and Guarantee Highlights">
  <div class="petssify-trust-col">
    <div class="petssify-trust-icon-box" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    </div>
    <div class="petssify-trust-content">
      <span class="petssify-trust-heading">Free shipping</span>
      <span class="petssify-trust-subtext">On orders over $50</span>
    </div>
  </div>

  <div class="petssify-trust-col">
    <div class="petssify-trust-icon-box" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="1 4 1 10 7 10"></polyline>
        <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
      </svg>
    </div>
    <div class="petssify-trust-content">
      <span class="petssify-trust-heading">30-day returns</span>
      <span class="petssify-trust-subtext">Hassle-free guarantee</span>
    </div>
  </div>

  <div class="petssify-trust-col">
    <div class="petssify-trust-icon-box" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
    </div>
    <div class="petssify-trust-content">
      <span class="petssify-trust-heading">Secure payment</span>
      <span class="petssify-trust-subtext">100% encrypted</span>
    </div>
  </div>
</div>
